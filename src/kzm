canary_general_test() {
    test_host=${1:-discord.com}
    test_path=${2:-/api/v9/experiments}
    test_profile=${3:-all}
    test_host=$(normalize_domain "$test_host")
    domain_valid "$test_host" || die "некорректный тестовый домен"
    case "$test_path" in /*) ;; *) die "путь теста должен начинаться с /" ;; esac
    canary_require
    [ -f "$KZM_SHARE/canary-pass.strategy" ] || die "не найден canary-pass.strategy"
    [ "$(count_profiles "$GENERAL_DIR")" -gt 0 ] || die "каталог пуст; выполните: kzm update"
    test_remote_ip=$(resolve_ipv4 "$test_host")
    ipv4_valid "$test_remote_ip" || die "не удалось получить IPv4 для $test_host"
    test_local_ip=$(route_source_ipv4 "$test_remote_ip")
    ipv4_valid "$test_local_ip" || die "не удалось определить исходящий IPv4"
    test_strategy_dir="$GENERAL_DIR"
    case "$test_profile" in
        all) ;;
        current)
            current_profile_file=$(profile_file_general)
            [ -f "$current_profile_file" ] || die "нет выбранной стратегии $GENERAL_PROFILE; выполните: kzm update"
            validate_strategy "$current_profile_file" || die "выбранная стратегия повреждена"
            make_tmp
            mkdir -p "$KZM_TMP/current-strategy" || die "не удалось подготовить текущую стратегию для теста"
            cp "$current_profile_file" "$KZM_TMP/current-strategy/current.strategy" || die "не удалось подготовить текущую стратегию для теста"
            test_strategy_dir="$KZM_TMP/current-strategy"
            ;;
        *) die "режим теста должен быть all или current" ;;
    esac
    say "Canary: $test_host ($test_remote_ip), источник $test_local_ip, очередь $CANARY_QUEUE_NUM."
    if [ "$test_profile" = current ]; then
        say "Сначала контроль без обхода, затем выбранная стратегия $GENERAL_PROFILE."
    else
        say "Сначала контроль без обхода, затем все v-профили."
    fi
    say "Рабочая очередь не меняется; у каждой попытки есть queue-bypass и TTL 30 секунд."
    if [ -n "${KZM_TEST_RESULT_FILE:-}" ]; then
        run_canary_general_matrix > "$KZM_TEST_RESULT_FILE"
    else
        run_canary_general_matrix
    fi
}

canary_suite_require() {
    canary_require
    [ -x "$KZM_LIBEXEC/router-canary-suite.sh" ] || die "не найден router-canary-suite.sh; переустановите менеджер"
    [ -r "$KZM_SHARE/test-targets.base.tsv" ] || die "не найден базовый список тестов; переустановите менеджер"
}

append_v_test_index() {
    test_index_target=$1
    find "$GENERAL_DIR" -type f -name 'v*.strategy' 2>/dev/null | \
        sed 's#.*/v##; s/\.strategy$//' | sort -n > "$KZM_TMP/test-v.ids"
    while IFS= read -r test_v_number; do
        [ -n "$test_v_number" ] || continue
        test_v_id="v$test_v_number"
        test_v_path="$GENERAL_DIR/$test_v_id.strategy"
        [ -f "$test_v_path" ] || continue
        validate_strategy "$test_v_path" || die "повреждена стратегия $test_v_id"
        printf '%s|%s|%s\n' "$test_v_id" "$test_v_id" "$test_v_path" >> "$test_index_target"
    done < "$KZM_TMP/test-v.ids"
}

append_flowseal_test_index() {
    test_index_target=$1
    [ -s "$FLOWSEAL_DIR/index.tsv" ] || die "каталог Flowseal пуст; выполните: kzm update"
    while IFS='|' read -r test_flow_id test_flow_label; do
        if [ -z "$test_flow_id" ] || [ -z "$test_flow_label" ]; then
            continue
        fi
        test_flow_path="$FLOWSEAL_DIR/$test_flow_id.strategy"
        [ -f "$test_flow_path" ] || die "нет Flowseal-профиля $test_flow_id"
        validate_strategy "$test_flow_path" || die "повреждён Flowseal-профиль $test_flow_label"
        printf 'flow:%s|%s|%s\n' "$test_flow_id" "$test_flow_label" "$test_flow_path" >> "$test_index_target"
    done < "$FLOWSEAL_DIR/index.tsv"
}

build_strategy_test_index() {
    test_set=$1
    test_index_target=$2
    : > "$test_index_target"
    case "$test_set" in
        current)
            test_current_path=$(profile_file_general)
            [ -f "$test_current_path" ] || die "нет выбранной стратегии $GENERAL_PROFILE; выполните: kzm update"
            validate_strategy "$test_current_path" || die "выбранная стратегия повреждена"
            printf '%s|%s|%s\n' "$GENERAL_PROFILE" "$(general_profile_label)" "$test_current_path" >> "$test_index_target"
            ;;
        v)
            append_v_test_index "$test_index_target"
            ;;
        flowseal)
            append_flowseal_test_index "$test_index_target"
            ;;
        all)
            # This order matches Zapret Manager: Flowseal first, then v-profiles.
            append_flowseal_test_index "$test_index_target"
            append_v_test_index "$test_index_target"
            ;;
        *) die "набор теста: current, v, flowseal или all" ;;
    esac
    [ -s "$test_index_target" ] || die "в выбранном наборе нет стратегий"
}

run_canary_suite_test() {
    test_set=$1
    test_targets_file=$2
    test_title=$3
    canary_suite_require
    validate_test_targets "$test_targets_file" 1 || die "список тестовых адресов повреждён"
    make_tmp
    build_strategy_test_index "$test_set" "$KZM_TMP/strategy-index.tsv"
    test_local_ip=$(route_source_ipv4 1.1.1.1)
    ipv4_valid "$test_local_ip" || die "не удалось определить исходящий IPv4 роутера"
    result_next="$LAST_TEST_RESULT.next.$$"
    rm -f "$result_next"
    say "Проверка: $test_title"
    say "Тестируется только HTTPS самого роутера; клиентский трафик и рабочая очередь не переключаются."
    if CANARY_SCRIPT="$KZM_LIBEXEC/router-canary.sh" \
        NFQWS_BIN="$KZM_CANARY_BIN" \
        CONTROL_STRATEGY="$KZM_SHARE/canary-pass.strategy" \
        STRATEGY_INDEX="$KZM_TMP/strategy-index.tsv" \
        TARGET_FILE="$test_targets_file" \
        RESULT_FILE="$result_next" \
        TEST_LOCAL_IP="$test_local_ip" \
        QUEUE_NUM="$CANARY_QUEUE_NUM" \
        PARALLEL=8 \
        CURL_TIMEOUT=7 \
        CANARY_TTL=120 \
        "$KZM_LIBEXEC/router-canary-suite.sh"; then
        grep -q '^strategy_id|strategy_label|target|ok|curl_rc|http_code|bytes|seconds|queue_packets$' "$result_next" || {
            rm -f "$result_next"
            warn "полный тест вернул некорректный результат"
            return 1
        }
        mv "$result_next" "$LAST_TEST_RESULT" || die "не удалось сохранить результат теста"
        printf '%s; %s\n' "$test_title" "$(date '+%Y-%m-%d %H:%M:%S')" > "$LAST_TEST_META.next.$$"
        mv "$LAST_TEST_META.next.$$" "$LAST_TEST_META" || die "не удалось сохранить описание теста"
    else
        rm -f "$result_next"
        return 1
    fi
}

canary_live_start() {
    test_kind=$1
    test_client_ip=$2
    test_ttl=${3:-120}
    ipv4_valid "$test_client_ip" || die "некорректный IPv4 клиента"
    canary_ttl_valid "$test_ttl" || die "TTL live-теста должен быть числом от 15 до 300 секунд"
    canary_live_require
    case "$test_kind" in
        voice)
            [ -f "$EXTRAS_DIR/discord-voice.strategy" ] || die "нет Discord voice-профиля; выполните: kzm update"
            make_tmp
            render_discord_voice_strategy "$EXTRAS_DIR/discord-voice.strategy" "$KZM_TMP/discord-voice-canary.strategy"
            validate_strategy "$KZM_TMP/discord-voice-canary.strategy" || die "повреждён Discord voice-профиль"
            test_strategy="$KZM_TMP/discord-voice-canary.strategy"
            test_ports='19294:19344,50000:50100'
            say "Canary использует выбранный fake: $(discord_fake_status_ru)"
            ;;
        quic)
            make_tmp
            render_quic_strategy "$KZM_TMP/quic-canary.strategy"
            test_strategy="$KZM_TMP/quic-canary.strategy"
            test_ports=443
            say "Тест: IPv4 $test_client_ip, UDP/443, ${test_ttl} с; без apply/restart, с автооткатом."
            if router_has_ipv6_default_route; then
                warn "IPv6 активен и не входит в canary: нулевой IPv4-счётчик неубедителен"
            else
                warn "IPv6 не входит в canary; нулевой IPv4-счётчик не доказывает, что стратегия не работает"
            fi
            if router_mihomo_running; then
                warn "Mihomo запущен: его перехват/REJECT UDP/443 до POSTROUTING даст нулевой счётчик"
            else
                warn "перехват/REJECT UDP/443 в Mihomo до POSTROUTING также даст нулевой счётчик"
            fi
            ;;
        *) die "live-тест поддерживает voice или quic" ;;
    esac
    NFQWS_BIN="$KZM_CANARY_BIN" \
    STRATEGY_FILE="$test_strategy" \
    TEST_LOCAL_IP="$test_client_ip" \
    TEST_REMOTE_IP=0.0.0.0/0 \
    TEST_PROTOCOL=udp \
    TEST_PORTS="$test_ports" \
    INBOUND_ENABLED=0 \
    QUEUE_NUM="$CANARY_QUEUE_NUM" \
    TTL="$test_ttl" \
    "$KZM_LIBEXEC/router-canary.sh" start
    case "$test_kind" in
        voice) say "Выйдите и снова войдите в Discord ГС, затем проверьте: kzm test status" ;;
        quic) say "Оставьте на тестовом устройстве только подключение через этот Keenetic, отключите VPN, полностью закройте YouTube или браузер, откройте заново и запустите новое видео; затем: kzm test status" ;;
    esac
}

canary_youtube_live_start() {
    test_client_ip=$1
    test_youtube_profile=$2
    test_ttl=${3:-120}
    ipv4_valid "$test_client_ip" || die "некорректный IPv4 клиента"
    youtube_profile_valid "$test_youtube_profile" || die "ожидается YouTube-профиль YvNN"
    canary_ttl_valid "$test_ttl" || die "TTL live-теста должен быть числом от 15 до 300 секунд"
    ensure_layout
    canary_live_require

    test_strategy="$YOUTUBE_DIR/$test_youtube_profile.strategy"
    [ -f "$test_strategy" ] || die "YouTube-профиль $test_youtube_profile не найден; выполните: kzm update"
    validate_strategy "$test_strategy" || die "повреждён YouTube-профиль $test_youtube_profile"
    if ! awk '
        /^--filter-tcp=([0-9,:]*,)?443(,[0-9,:]*)?$/ { found=1 }
        END { exit found ? 0 : 1 }
    ' "$test_strategy"; then
        die "профиль $test_youtube_profile не содержит TCP/443 и не подходит для этого live-теста"
    fi

    test_mihomo_bypass=0
    if router_mihomo_transparent_running; then
        test_mihomo_bypass=1
        say "Обнаружен прозрачный Mihomo: для устройства временно обходится только MIHOMO_REDIRECT TCP/443."
    elif router_mihomo_running; then
        warn "Mihomo запущен, но поддерживаемая цепочка MIHOMO_REDIRECT не найдена; его перехват может дать нулевой счётчик"
    fi

    say "Тест: IPv4 $test_client_ip, профиль $test_youtube_profile, TCP/443, ${test_ttl} с."
    say "Основной nfqws и конфиг не меняются; тест идёт без apply/restart, откат — автоматически по TTL."
    CANARY_MIHOMO_BYPASS="$test_mihomo_bypass" \
    NFQWS_BIN="$KZM_CANARY_BIN" \
    STRATEGY_FILE="$test_strategy" \
    TEST_LOCAL_IP="$test_client_ip" \
    TEST_REMOTE_IP=0.0.0.0/0 \
    TEST_PROTOCOL=tcp \
    TEST_PORTS=443 \
    INBOUND_ENABLED=0 \
    QUEUE_NUM="$CANARY_QUEUE_NUM" \
    TTL="$test_ttl" \
    "$KZM_LIBEXEC/router-canary.sh" start
    say "Оставьте на тестовом устройстве только подключение через этот Keenetic, отключите VPN, полностью закройте YouTube или браузер, откройте заново и запустите новое видео; затем: kzm test status"
}

canary_status() {
    [ -x "$KZM_LIBEXEC/router-canary.sh" ] || die "не найден router-canary.sh"
    canary_status_rc=0
    "$KZM_LIBEXEC/router-canary.sh" status || canary_status_rc=$?
    if [ "$canary_status_rc" -eq 0 ]; then
        say "Как читать: pkts > 0 — IPv4-трафик дошёл до canary, но это ещё не доказывает совпадение домена или успешный обход; pkts = 0 — проверьте IP устройства, IPv6, VPN/мобильную сеть и Mihomo."
        say "Автооткат — по TTL; немедленный — kzm test stop."
    fi
    return "$canary_status_rc"
}

canary_stop() {
    [ -x "$KZM_LIBEXEC/router-canary.sh" ] || die "не найден router-canary.sh"
    "$KZM_LIBEXEC/router-canary.sh" stop
}

build_domain_targets() {
    domain_target_file=$1
    shift
    [ "$#" -gt 0 ] || die "укажите хотя бы один домен"
    : > "$domain_target_file"
    domain_target_count=0
    for raw_test_domain in "$@"; do
        clean_test_domain=$(normalize_domain "$raw_test_domain")
        domain_valid "$clean_test_domain" || die "некорректный тестовый домен: $raw_test_domain"
        if ! awk -F'|' -v name="$clean_test_domain" '$1 == name { found=1 } END { exit found ? 0 : 1 }' "$domain_target_file"; then
            printf '%s|https://%s/\n' "$clean_test_domain" "$clean_test_domain" >> "$domain_target_file"
            domain_target_count=$((domain_target_count + 1))
        fi
        [ "$domain_target_count" -le 25 ] || die "за один запуск можно проверить не больше 25 доменов"
    done
}

canary_domain_suite_test() {
    select_tmp_base
    domain_tmp=$(mktemp "$KZM_TMP_BASE/kzm-domains.XXXXXX") || die "не удалось создать временный список доменов"
    trap 'rm -f "$domain_tmp"; cleanup_tmp' 0
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    build_domain_targets "$domain_tmp" "$@"
    domain_count=$(awk 'END { print NR+0 }' "$domain_tmp")
    run_canary_suite_test all "$domain_tmp" "v + Flowseal на пользовательских доменах ($domain_count)"
    rm -f "$domain_tmp"
    trap cleanup_tmp 0
}

canary_test_command() {
    test_command=${1:-status}
    [ "$#" -eq 0 ] || shift
    case "$test_command" in
        engine-update) canary_engine_update ;;
        general) canary_general_test "${1:-discord.com}" "${2:-/api/v9/experiments}" ;;
        suite)
            suite_set=${1:-current}
            case "$suite_set" in current|v|flowseal|all) ;; *) die "suite: current, v, flowseal или all" ;; esac
            run_canary_suite_test "$suite_set" "$TEST_TARGETS" "полный список, набор $suite_set"
            show_strategy_test_results "$LAST_TEST_RESULT"
            ;;
        domain)
            [ "$#" -gt 0 ] || die "используйте: kzm test domain DOMAIN..."
            canary_domain_suite_test "$@"
            show_strategy_test_results "$LAST_TEST_RESULT"
            ;;
        voice)
            [ "${1:-}" = start ] || die "используйте: kzm test voice start CLIENT_IP [TTL]"
            [ -n "${2:-}" ] || die "укажите IPv4 клиента"
            canary_live_start voice "$2" "${3:-120}"
            ;;
        quic)
            [ "${1:-}" = start ] || die "используйте: kzm test quic start CLIENT_IP [TTL]"
            [ -n "${2:-}" ] || die "укажите IPv4 клиента"
            canary_live_start quic "$2" "${3:-120}"
            ;;
        youtube)
            [ "${1:-}" = start ] || die "используйте: kzm test youtube start CLIENT_IP PROFILE [TTL]"
            [ -n "${2:-}" ] || die "укажите IPv4 клиента"
            [ -n "${3:-}" ] || die "укажите YouTube-профиль YvNN"
            canary_youtube_live_start "$2" "$3" "${4:-120}"
            ;;
        status) canary_status ;;
        stop) canary_stop ;;
        *) die "test: engine-update, suite [current|v|flowseal|all], domain DOMAIN..., general [HOST PATH], voice/quic/youtube, status или stop" ;;
    esac
}

