#!/bin/sh

set -u

KZM_VERSION="0.8.1"
KZM_ROOT="${KZM_ROOT:-}"
KZM_PREFIX="${KZM_PREFIX:-/opt}"
KZM_BASE="${KZM_ROOT}${KZM_PREFIX}"
KZM_ETC="${KZM_ETC:-$KZM_BASE/etc/kzapret-manager}"
KZM_SHARE="${KZM_SHARE:-$KZM_BASE/share/kzm}"
KZM_LIBEXEC="${KZM_LIBEXEC:-$KZM_BASE/libexec/kzm}"
KZM_CONFIG="${KZM_CONFIG:-$KZM_ETC/kzm.conf}"
KZM_TMP=""
KZM_TMP_BASE=""
KZM_PROC_ROOT="${KZM_PROC_ROOT:-/proc}"

NFQWS_DIR="${NFQWS_DIR:-$KZM_BASE/etc/nfqws}"
NFQWS_CONFIG="${NFQWS_CONFIG:-$NFQWS_DIR/nfqws.conf}"
NFQWS_INIT="${NFQWS_INIT:-$KZM_BASE/etc/init.d/S51nfqws}"
NFQWS_BIN="${NFQWS_BIN:-$KZM_BASE/usr/bin/nfqws}"
NFQWS2_INIT="${NFQWS2_INIT:-$KZM_BASE/etc/init.d/S51nfqws2}"

STATE_FILE="$KZM_ETC/state.conf"
CATALOG_DIR="$KZM_ETC/strategies"
GENERAL_DIR="$CATALOG_DIR/general"
FLOWSEAL_DIR="$CATALOG_DIR/flowseal"
YOUTUBE_DIR="$CATALOG_DIR/youtube"
EXTRAS_DIR="$CATALOG_DIR/extras"
DISCORD_DIR="$CATALOG_DIR/discord"
DISCORD_SCRIPT_DIR="$CATALOG_DIR/discord-scripts"
CUSTOM_DIR="$CATALOG_DIR/custom"
LIST_DIR="$KZM_ETC/lists"
FAKE_DIR="$KZM_ETC/fake"
BACKUP_DIR="$KZM_ETC/backups"
TOOLS_DIR="$KZM_ETC/tools"
RESULT_DIR="$KZM_ETC/results"
ACTIVE_STRATEGY="$KZM_ETC/active.strategy"
CONFIGURED_STATE="$KZM_ETC/configured-state.conf"
RUNNING_STATE="$KZM_ETC/running-state.conf"
LAST_TEST_RESULT="$RESULT_DIR/last-strategy-test.csv"
LAST_TEST_META="$RESULT_DIR/last-strategy-test.meta"
USER_LIST="$LIST_DIR/user.list"
USER_IPSET="$LIST_DIR/user-ipset.list"
AUTO_LIST="$LIST_DIR/auto.list"
YOUTUBE_LIST="$LIST_DIR/youtube.list"
EXCLUDE_LIST="$LIST_DIR/exclude.list"
TEST_TARGETS="$LIST_DIR/test-targets.tsv"

GENERAL_URL="https://raw.githubusercontent.com/StressOzz/Zapret-Manager/main/Strategies.md"
YOUTUBE_URL="https://raw.githubusercontent.com/StressOzz/Zapret-Manager/main/files/StrYoutube"
DISCORD_URL="https://raw.githubusercontent.com/StressOzz/Zapret-Manager/main/Zapret-Manager.sh"
DISCORD_STUN4ALL_URL="https://raw.githubusercontent.com/bol-van/zapret/master/init.d/custom.d.examples.linux/50-stun4all"
DISCORD_QUIC4ALL_URL="https://raw.githubusercontent.com/bol-van/zapret/master/init.d/custom.d.examples.linux/50-quic4all"
DISCORD_MEDIA_SCRIPT_URL="https://raw.githubusercontent.com/bol-van/zapret/master/init.d/custom.d.examples.linux/50-discord-media"
DISCORD_LEGACY_SCRIPT_URL="https://raw.githubusercontent.com/bol-van/zapret/v70.5/init.d/custom.d.examples.linux/50-discord"
EXCLUDE_URL="https://raw.githubusercontent.com/StressOzz/Zapret-Manager/main/zapret-hosts-user-exclude.txt"
FLOWSEAL_ZIP_URL="https://github.com/Flowseal/zapret-discord-youtube/archive/refs/heads/main.zip"
TEST_SUITE_V2_URL="https://raw.githubusercontent.com/hyperion-cs/dpi-checkers/main/ru/tcp-16-20/suite.v2.json"
BOLVAN_FAKE_BASE_URL="https://raw.githubusercontent.com/bol-van/zapret/master/files/fake"
FLOWSEAL_FAKE_BASE_URL="https://raw.githubusercontent.com/Flowseal/zapret-discord-youtube/main/bin"
CANARY_FEED_URL="https://nfqws.github.io/nfqws-keenetic/aarch64"
CANARY_QUEUE_NUM=301
MIN_FULL_TEST_TARGETS=50
KZM_CANARY_BIN="$TOOLS_DIR/nfqws"
MIHOMO_LOG="${MIHOMO_LOG:-$KZM_BASE/var/log/mihomo.log}"
BACKUP_KEEP=10
RECOMMENDED_GENERAL_PROFILE=v7
RECOMMENDED_YOUTUBE_PROFILE=Yv08
RECOMMENDED_DISCORD_MEDIA_PROFILE=Dv1

if [ -r "$KZM_CONFIG" ]; then
    # shellcheck disable=SC1090
    . "$KZM_CONFIG"
fi

case "$MIN_FULL_TEST_TARGETS" in
    ''|*[!0-9]*) MIN_FULL_TEST_TARGETS=50 ;;
esac
if [ "$MIN_FULL_TEST_TARGETS" -lt 23 ] 2>/dev/null; then
    MIN_FULL_TEST_TARGETS=23
fi

GENERAL_PROFILE=v7
YOUTUBE_PROFILE=Yv08
DISCORD_ENABLED=0
DISCORD_MEDIA_PROFILE=Dv1
DISCORD_SCRIPT=off
DISCORD_FAKE=stun.bin
QUIC_ENABLED=0
GAME_ENABLED=0
TRAFFIC_SCOPE=all

if [ -r "$STATE_FILE" ]; then
    # shellcheck disable=SC1090
    . "$STATE_FILE"
fi

say() {
    printf '%s\n' "$*"
}

warn() {
    printf 'Внимание: %s\n' "$*" >&2
}

die() {
    printf 'Ошибка: %s\n' "$*" >&2
    exit 1
}

cleanup_tmp() {
    if [ -n "$KZM_TMP" ]; then
        case "$KZM_TMP" in
            "$KZM_TMP_BASE"/kzm.*)
                rm -rf "$KZM_TMP"
                ;;
        esac
    fi
    KZM_TMP=""
}

select_tmp_base() {
    if [ -n "$KZM_ROOT" ]; then
        KZM_TMP_BASE="$KZM_ROOT/tmp"
        mkdir -p "$KZM_TMP_BASE" || die "не удалось создать тестовый временный каталог"
    else
        # Ignore Entware TMPDIR=/opt/tmp: downloads and generated archives must
        # live on tmpfs, not accumulate on flash storage.
        KZM_TMP_BASE=/tmp
    fi
}

make_tmp() {
    if [ -n "$KZM_TMP" ]; then
        cleanup_tmp
    fi
    select_tmp_base
    KZM_TMP=$(mktemp -d "$KZM_TMP_BASE/kzm.XXXXXX") || die "не удалось создать временный каталог"
    trap cleanup_tmp 0
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
}

ensure_layout() {
    mkdir -p "$GENERAL_DIR" "$FLOWSEAL_DIR" "$YOUTUBE_DIR" "$EXTRAS_DIR" "$DISCORD_DIR" "$DISCORD_SCRIPT_DIR" "$CUSTOM_DIR" "$LIST_DIR" "$FAKE_DIR" "$BACKUP_DIR" "$TOOLS_DIR" "$RESULT_DIR" || die "не удалось создать каталоги менеджера"
    if [ ! -f "$STATE_FILE" ]; then
        if [ -r "$KZM_SHARE/state.default" ]; then
            cp "$KZM_SHARE/state.default" "$STATE_FILE" || die "не удалось создать state.conf"
        else
            write_state_file
        fi
    fi
    if [ ! -f "$YOUTUBE_LIST" ] && [ -r "$KZM_SHARE/youtube.list" ]; then
        cp "$KZM_SHARE/youtube.list" "$YOUTUBE_LIST" || die "не удалось создать youtube.list"
    fi
    [ -f "$USER_LIST" ] || : > "$USER_LIST"
    [ -f "$USER_IPSET" ] || : > "$USER_IPSET"
    [ -f "$AUTO_LIST" ] || : > "$AUTO_LIST"
    [ -f "$EXCLUDE_LIST" ] || : > "$EXCLUDE_LIST"
    if [ ! -f "$TEST_TARGETS" ] && [ -r "$KZM_SHARE/test-targets.base.tsv" ]; then
        cp "$KZM_SHARE/test-targets.base.tsv" "$TEST_TARGETS" || die "не удалось создать базовый список тестов"
    fi
}

write_state_file() {
    state_tmp="$STATE_FILE.tmp.$$"
    {
        printf 'GENERAL_PROFILE=%s\n' "$GENERAL_PROFILE"
        printf 'YOUTUBE_PROFILE=%s\n' "$YOUTUBE_PROFILE"
        printf 'DISCORD_ENABLED=%s\n' "$DISCORD_ENABLED"
        printf 'DISCORD_MEDIA_PROFILE=%s\n' "$DISCORD_MEDIA_PROFILE"
        printf 'DISCORD_SCRIPT=%s\n' "$DISCORD_SCRIPT"
        printf 'DISCORD_FAKE=%s\n' "$DISCORD_FAKE"
        printf 'QUIC_ENABLED=%s\n' "$QUIC_ENABLED"
        printf 'GAME_ENABLED=%s\n' "$GAME_ENABLED"
        printf 'TRAFFIC_SCOPE=%s\n' "$TRAFFIC_SCOPE"
    } > "$state_tmp" || die "не удалось записать state.conf"
    chmod 600 "$state_tmp" 2>/dev/null || true
    mv "$state_tmp" "$STATE_FILE" || die "не удалось применить state.conf"
}

validate_state() {
    case "$GENERAL_PROFILE" in
        v[0-9]*|flow:*|custom:*) ;;
        *) die "некорректный GENERAL_PROFILE в state.conf" ;;
    esac
    case "$YOUTUBE_PROFILE" in
        off|Yv[0-9]*) ;;
        *) die "некорректный YOUTUBE_PROFILE в state.conf" ;;
    esac
    case "$DISCORD_MEDIA_PROFILE" in
        off|Dv[0-9]*) ;;
        *) die "некорректный DISCORD_MEDIA_PROFILE в state.conf" ;;
    esac
    case "$DISCORD_SCRIPT" in
        off|50-discord-media) ;;
        50-stun4all|50-quic4all|50-discord) die "$DISCORD_SCRIPT недоступен в безопасном режиме Keenetic" ;;
        *) die "некорректный DISCORD_SCRIPT в state.conf" ;;
    esac
    case "$DISCORD_FAKE" in
        off|stun.bin|stun2.bin|quic_initial_4pda_to.bin|quic_initial_tencent_com.bin|tls_clienthello_sochi_park.bin|quic_initial_www_google_com.bin|quic_initial_steamcommunity_com.bin|quic_initial_5ka_ru.bin|quic_initial_rutube_ru.bin) ;;
        *) die "некорректный DISCORD_FAKE в state.conf" ;;
    esac
    case "$DISCORD_ENABLED:$QUIC_ENABLED:$GAME_ENABLED" in
        [01]:[01]:[01]) ;;
        *) die "флаги Discord/QUIC/Game должны быть 0 или 1" ;;
    esac
    case "$TRAFFIC_SCOPE" in
        all|list|auto) ;;
        *) die "TRAFFIC_SCOPE должен быть all, list или auto" ;;
    esac
}

fetch_url() {
    fetch_source=$1
    fetch_target=$2
    case "$fetch_source" in
        file://*)
            cp "${fetch_source#file://}" "$fetch_target"
            return $?
            ;;
    esac
    if [ -f "$fetch_source" ]; then
        cp "$fetch_source" "$fetch_target"
    elif command -v curl >/dev/null 2>&1; then
        curl -fsSL --connect-timeout 30 "$fetch_source" -o "$fetch_target"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -T 30 -O "$fetch_target" "$fetch_source"
    else
        die "нужен wget или curl"
    fi
}

validate_strategy() {
    validate_file=$1
    awk '
        /^[[:space:]]*$/ || /^#/ { next }
        $0 !~ /^--/ { print "строка не начинается с --: " $0 > "/dev/stderr"; bad=1; next }
        $0 ~ /[^A-Za-z0-9_.:,+=\/@!%~ -]/ { print "запрещённый символ: " $0 > "/dev/stderr"; bad=1 }
        {
            option=$0
            sub(/[=[:space:]].*/, "", option)
            if (option != "--new" &&
                option !~ /^--filter-(tcp|udp|l3|l7)$/ &&
                option !~ /^--hostlist(-domains|-exclude|-exclude-domains|-auto)?$/ &&
                option !~ /^--ipset(-exclude)?(-ip)?$/ &&
                option != "--ip-id" &&
                option !~ /^--dpi-desync([A-Za-z0-9_-]*)$/ &&
                option !~ /^--dup([A-Za-z0-9_-]*)$/) {
                print "неразрешённая управляющая опция: " option > "/dev/stderr"
                bad=1
            }
        }
        END { exit bad ? 1 : 0 }
    ' "$validate_file"
}

count_profiles() {
    count_dir=$1
    find "$count_dir" -type f -name '*.strategy' 2>/dev/null | awk 'END { print NR + 0 }'
}

update_exclude_list() {
    exclude_tmp=$1
    if ! fetch_url "$EXCLUDE_URL" "$exclude_tmp"; then
        warn "список исключений не скачан; прежний файл сохранён"
        return 1
    fi
    awk '
        { sub(/\r$/, "") }
        /^[[:space:]]*$/ { next }
        /^#/ { print; next }
        $0 ~ /[[:space:]\047\042`$;&|<>\\]/ { next }
        { print }
    ' "$exclude_tmp" > "$exclude_tmp.clean"
    [ -s "$exclude_tmp.clean" ] || return 1
    cp "$exclude_tmp.clean" "$EXCLUDE_LIST.next.$$" || return 1
    mv "$EXCLUDE_LIST.next.$$" "$EXCLUDE_LIST"
}

replace_catalog_dir() {
    replace_source=$1
    replace_target=$2
    replace_name=$3
    replace_next="$CATALOG_DIR/.$replace_name.next.$$"
    replace_old="$CATALOG_DIR/.$replace_name.old.$$"

    case "$replace_next:$replace_old:$replace_target" in
        "$CATALOG_DIR"/.*:"$CATALOG_DIR"/.*:"$CATALOG_DIR"/*) ;;
        *) die "отказ от замены неожиданного пути каталога" ;;
    esac
    rm -rf "$replace_next" "$replace_old"
    mkdir -p "$replace_next" || die "не удалось подготовить каталог $replace_name"
    cp -R "$replace_source"/. "$replace_next"/ || die "не удалось скопировать каталог $replace_name"
    if [ -d "$replace_target" ]; then
        mv "$replace_target" "$replace_old" || die "не удалось зарезервировать каталог $replace_name"
    fi
    if mv "$replace_next" "$replace_target"; then
        rm -rf "$replace_old"
    else
        [ -d "$replace_old" ] && mv "$replace_old" "$replace_target"
        die "не удалось атомарно заменить каталог $replace_name"
    fi
}

validate_test_targets() {
    minimum_targets=${2:-23}
    awk -F'|' -v minimum="$minimum_targets" '
        NF != 2 { bad=1; next }
        $1 !~ /^[A-Za-z0-9][A-Za-z0-9_.-]*$/ { bad=1 }
        $2 !~ /^https:\/\/[A-Za-z0-9]/ || $2 ~ /[[:space:]|]/ { bad=1 }
        seen[$1]++ { bad=1 }
        END { exit bad || NR < minimum ? 1 : 0 }
    ' "$1"
}

update_test_targets() {
    test_suite_download=$1
    test_targets_next="$KZM_TMP/test-targets.tsv"
    [ -r "$KZM_SHARE/test-targets.base.tsv" ] || {
        warn "нет встроенного списка тестовых доменов; прежний список сохранён"
        return 1
    }
    if ! fetch_url "$TEST_SUITE_V2_URL" "$test_suite_download"; then
        warn "DPI-список Hyperion не скачан; прежний список тестов сохранён"
        return 1
    fi
    cp "$KZM_SHARE/test-targets.base.tsv" "$test_targets_next" || return 1
    awk -f "$KZM_LIBEXEC/import-suite-v2.awk" "$test_suite_download" >> "$test_targets_next" || return 1
    awk -F'|' '!seen[$1]++ { print }' "$test_targets_next" > "$test_targets_next.clean" || return 1
    validate_test_targets "$test_targets_next.clean" || {
        warn "новый список тестов повреждён; прежний список сохранён"
        return 1
    }
    test_target_count=$(awk 'END { print NR+0 }' "$test_targets_next.clean")
    [ "$test_target_count" -ge "$MIN_FULL_TEST_TARGETS" ] || {
        warn "в полном списке только $test_target_count целей; ожидалось не меньше $MIN_FULL_TEST_TARGETS, прежний список сохранён"
        return 1
    }
    cp "$test_targets_next.clean" "$TEST_TARGETS.next.$$" || return 1
    mv "$TEST_TARGETS.next.$$" "$TEST_TARGETS" || return 1
    say "Обновлён список тестов Zapret Manager/Hyperion: $test_target_count целей."
}

prepare_flowseal_catalog() {
    flow_output=$1
    mkdir -p "$flow_output" || die "не удалось подготовить каталог Flowseal"
    : > "$flow_output/index.tsv"

    if [ -n "${FLOWSEAL_SOURCE_DIR:-}" ]; then
        [ -d "$FLOWSEAL_SOURCE_DIR" ] || die "FLOWSEAL_SOURCE_DIR не существует"
        flow_base=$FLOWSEAL_SOURCE_DIR
    else
        command -v unzip >/dev/null 2>&1 || die "для импорта Flowseal нужен unzip: opkg install unzip"
        say "Скачиваю стратегии Flowseal..."
        fetch_url "$FLOWSEAL_ZIP_URL" "$KZM_TMP/flowseal.zip" || die "не удалось скачать Flowseal main.zip"
        unzip -tq "$KZM_TMP/flowseal.zip" >/dev/null 2>&1 || die "архив Flowseal повреждён"
        if ! unzip -Z1 "$KZM_TMP/flowseal.zip" > "$KZM_TMP/flowseal.entries" 2>/dev/null; then
            # BusyBox unzip has no -Z1. Its listing keeps the full filename,
            # including spaces, after the fixed length/date/time columns.
            unzip -lq "$KZM_TMP/flowseal.zip" 2>/dev/null | awk '
                /^[[:space:]]*[0-9]+[[:space:]]+[0-9-]+[[:space:]]+[0-9:]+[[:space:]]+/ {
                    name=$0
                    sub(/^[[:space:]]*[0-9]+[[:space:]]+[0-9-]+[[:space:]]+[0-9:]+[[:space:]]+/, "", name)
                    print name
                }
            ' > "$KZM_TMP/flowseal.entries" || die "unzip не смог показать список файлов Flowseal"
        fi
        [ -s "$KZM_TMP/flowseal.entries" ] || die "архив Flowseal не содержит файлов"
        awk -F/ '
            $1 == "" { bad=1 }
            $1 ~ /^[A-Za-z]:$/ { bad=1 }
            index($0, "\\") { bad=1 }
            { for (i=1; i<=NF; i++) if ($i == "..") bad=1 }
            END { exit bad ? 1 : 0 }
        ' "$KZM_TMP/flowseal.entries" || die "архив Flowseal содержит небезопасный путь"
        mkdir -p "$KZM_TMP/flowseal-source" || die "не удалось подготовить распаковку Flowseal"
        unzip -oq "$KZM_TMP/flowseal.zip" -d "$KZM_TMP/flowseal-source" || die "не удалось распаковать Flowseal"
        flow_base=$KZM_TMP/flowseal-source
    fi

    find "$flow_base" -type f -name 'general*.bat' 2>/dev/null | sort > "$KZM_TMP/flowseal.files"
    while IFS= read -r flow_file; do
        [ -f "$flow_file" ] || continue
        flow_label=${flow_file##*/}
        flow_label=${flow_label%.bat}
        [ "$flow_label" != 'general (ALT5)' ] || continue
        case "$flow_label" in *'|'*) die "небезопасное имя Flowseal-профиля" ;; esac
        flow_id=$(printf '%s\n' "$flow_label" | sed -e 's/[^A-Za-z0-9]/_/g' -e 's/__*/_/g' -e 's/^_//' -e 's/_$//')
        case "$flow_id" in ''|*[!A-Za-z0-9_]*) die "не удалось сформировать ID Flowseal-профиля" ;; esac
        [ ! -e "$flow_output/$flow_id.strategy" ] || die "повторяющийся ID Flowseal: $flow_id"
        awk \
            -v output_file="$flow_output/$flow_id.strategy" \
            -v profile_label="$flow_label" \
            -v exclude_file="$EXCLUDE_LIST" \
            -v fake_dir="$FAKE_DIR" \
            -f "$KZM_LIBEXEC/import-flowseal.awk" \
            "$flow_file" || die "не удалось импортировать Flowseal-профиль $flow_label"
        printf '%s|%s\n' "$flow_id" "$flow_label" >> "$flow_output/index.tsv"
    done < "$KZM_TMP/flowseal.files"
}

prepare_discord_script_catalog() {
    discord_script_output=$1
    mkdir -p "$discord_script_output" || die "не удалось подготовить каталог Discord 50-*"

    grep -F 'DNUM_STUN4ALL' "$KZM_TMP/50-stun4all.source" >/dev/null 2>&1 || die "источник 50-stun4all изменил ожидаемый формат"
    grep -F 'DNUM_QUIC4ALL' "$KZM_TMP/50-quic4all.source" >/dev/null 2>&1 || die "источник 50-quic4all изменил ожидаемый формат"
    grep -F 'DISCORD_MEDIA_PORT_RANGE' "$KZM_TMP/50-discord-media.source" >/dev/null 2>&1 || die "источник 50-discord-media изменил ожидаемый формат"
    grep -F 'DISCORD_SUBNETS=' "$KZM_TMP/50-discord.source" >/dev/null 2>&1 || die "источник 50-discord изменил ожидаемый формат"

    {
        printf '%s\n' 'mode|upstream|source|support|mapping'
        printf '50-stun4all|bol-van/zapret master|%s|unsupported-safe|requires packet-signature firewall hook on all UDP\n' "$DISCORD_STUN4ALL_URL"
        printf '50-quic4all|bol-van/zapret master|%s|unsupported-safe|requires QUIC-initial firewall signature on all UDP\n' "$DISCORD_QUIC4ALL_URL"
        printf '50-discord-media|bol-van/zapret master|%s|native-alias|existing KZM discord,stun voice/media block; no second block\n' "$DISCORD_MEDIA_SCRIPT_URL"
        printf '50-discord|bol-van/zapret v70.5|%s|unsupported-safe|requires frozen destination ipset and first-packet firewall hook\n' "$DISCORD_LEGACY_SCRIPT_URL"
    } > "$discord_script_output/sources.tsv"
}

catalog_update() {
    ensure_layout
    make_tmp
    mkdir -p "$KZM_TMP/general" "$KZM_TMP/flowseal" "$KZM_TMP/youtube" "$KZM_TMP/extras" "$KZM_TMP/discord" "$KZM_TMP/discord-scripts"

    say "Скачиваю каталог v1-v10..."
    fetch_url "$GENERAL_URL" "$KZM_TMP/Strategies.md" || die "не удалось скачать Strategies.md"
    awk \
        -v general_dir="$KZM_TMP/general" \
        -v extras_dir="$KZM_TMP/extras" \
        -v exclude_file="$EXCLUDE_LIST" \
        -v youtube_file="$YOUTUBE_LIST" \
        -v fake_dir="$FAKE_DIR" \
        -f "$KZM_LIBEXEC/import-general.awk" \
        "$KZM_TMP/Strategies.md" || die "не удалось разобрать Strategies.md"

    say "Скачиваю каталог YouTube..."
    fetch_url "$YOUTUBE_URL" "$KZM_TMP/StrYoutube" || die "не удалось скачать StrYoutube"
    awk \
        -v youtube_dir="$KZM_TMP/youtube" \
        -v youtube_file="$YOUTUBE_LIST" \
        -v fake_dir="$FAKE_DIR" \
        -f "$KZM_LIBEXEC/import-youtube.awk" \
        "$KZM_TMP/StrYoutube" || die "не удалось разобрать StrYoutube"

    say "Скачиваю профили Discord media..."
    fetch_url "$DISCORD_URL" "$KZM_TMP/Zapret-Manager.sh" || die "не удалось скачать Zapret-Manager.sh"
    awk \
        -v discord_dir="$KZM_TMP/discord" \
        -v fake_dir="$FAKE_DIR" \
        -f "$KZM_LIBEXEC/import-discord.awk" \
        "$KZM_TMP/Zapret-Manager.sh" || die "не удалось разобрать Discord Dv-профили"

    say "Проверяю источники дополнительных Discord 50-* режимов..."
    fetch_url "$DISCORD_STUN4ALL_URL" "$KZM_TMP/50-stun4all.source" || die "не удалось скачать источник 50-stun4all"
    fetch_url "$DISCORD_QUIC4ALL_URL" "$KZM_TMP/50-quic4all.source" || die "не удалось скачать источник 50-quic4all"
    fetch_url "$DISCORD_MEDIA_SCRIPT_URL" "$KZM_TMP/50-discord-media.source" || die "не удалось скачать источник 50-discord-media"
    fetch_url "$DISCORD_LEGACY_SCRIPT_URL" "$KZM_TMP/50-discord.source" || die "не удалось скачать источник 50-discord"
    prepare_discord_script_catalog "$KZM_TMP/discord-scripts"

    prepare_flowseal_catalog "$KZM_TMP/flowseal"

    general_count=$(count_profiles "$KZM_TMP/general")
    flowseal_count=$(count_profiles "$KZM_TMP/flowseal")
    youtube_count=$(count_profiles "$KZM_TMP/youtube")
    discord_count=$(count_profiles "$KZM_TMP/discord")
    [ "$general_count" -ge 1 ] || die "в Strategies.md не найдено ни одной стратегии"
    [ "$flowseal_count" -ge 1 ] || die "не найдено ни одной Flowseal-стратегии"
    [ "$youtube_count" -ge 1 ] || die "в StrYoutube не найдено ни одной стратегии"
    [ "$discord_count" -ge 1 ] || die "в Zapret-Manager.sh не найдено ни одного Dv-профиля"

    for strategy_file in "$KZM_TMP"/general/*.strategy "$KZM_TMP"/flowseal/*.strategy "$KZM_TMP"/youtube/*.strategy "$KZM_TMP"/extras/*.strategy "$KZM_TMP"/discord/*.strategy; do
        [ -f "$strategy_file" ] || continue
        validate_strategy "$strategy_file" || die "опасная или повреждённая стратегия: $strategy_file"
    done

    replace_catalog_dir "$KZM_TMP/general" "$GENERAL_DIR" general
    replace_catalog_dir "$KZM_TMP/flowseal" "$FLOWSEAL_DIR" flowseal
    replace_catalog_dir "$KZM_TMP/youtube" "$YOUTUBE_DIR" youtube
    replace_catalog_dir "$KZM_TMP/extras" "$EXTRAS_DIR" extras
    replace_catalog_dir "$KZM_TMP/discord" "$DISCORD_DIR" discord
    replace_catalog_dir "$KZM_TMP/discord-scripts" "$DISCORD_SCRIPT_DIR" discord-scripts
    update_exclude_list "$KZM_TMP/exclude.list" || true
    update_test_targets "$KZM_TMP/suite.v2.json" || true
    date -u '+%Y-%m-%dT%H:%M:%SZ' > "$CATALOG_DIR/updated_at"

    say "Импортировано: v=$general_count, Flowseal=$flowseal_count, YouTube=$youtube_count, Discord media=$discord_count; источники Discord 50-* проверены."
    assets_update
}

fake_references() {
    {
        # The QUIC profile is generated locally rather than stored in the catalog.
        printf '%s\n' 'quic_initial_www_google_com.bin'
        [ "$DISCORD_FAKE" = off ] || printf '%s\n' "$DISCORD_FAKE"
        find "$CATALOG_DIR" -type f -name '*.strategy' 2>/dev/null | while IFS= read -r strategy_file; do
        awk -v prefix="$FAKE_DIR/" '
            index($0, prefix) {
                value = substr($0, index($0, prefix) + length(prefix))
                sub(/[[:space:]].*$/, "", value)
                if (value ~ /^[A-Za-z0-9_.-]+$/) print value
            }
        ' "$strategy_file"
        done
    } | sort -u
}

fetch_fake_asset() {
    fake_asset_name=$1
    fake_asset_target=$2
    case "$fake_asset_name" in
        stun2.bin|quic_initial_4pda_to.bin|quic_initial_tencent_com.bin|tls_clienthello_sochi_park.bin|quic_initial_steamcommunity_com.bin|quic_initial_5ka_ru.bin|quic_initial_rutube_ru.bin)
            fetch_url "$FLOWSEAL_FAKE_BASE_URL/$fake_asset_name" "$fake_asset_target" 2>/dev/null || \
                fetch_url "$BOLVAN_FAKE_BASE_URL/$fake_asset_name" "$fake_asset_target" 2>/dev/null
            ;;
        *)
            fetch_url "$BOLVAN_FAKE_BASE_URL/$fake_asset_name" "$fake_asset_target" 2>/dev/null || \
                fetch_url "$FLOWSEAL_FAKE_BASE_URL/$fake_asset_name" "$fake_asset_target" 2>/dev/null
            ;;
    esac
}

assets_update() {
    ensure_layout
    if [ -z "${KZM_TMP:-}" ]; then
        make_tmp
    fi
    asset_failures=0
    asset_total=0
    fake_references > "$KZM_TMP/fake.references"
    while IFS= read -r fake_name; do
        [ -n "$fake_name" ] || continue
        if [ -s "$FAKE_DIR/$fake_name" ]; then
            continue
        fi
        asset_total=$((asset_total + 1))
        asset_tmp="$KZM_TMP/$fake_name"
        if fetch_fake_asset "$fake_name" "$asset_tmp"; then
            if [ -s "$asset_tmp" ]; then
                mv "$asset_tmp" "$FAKE_DIR/$fake_name"
                say "Загружен fake-файл: $fake_name"
            else
                asset_failures=$((asset_failures + 1))
            fi
        else
            rm -f "$asset_tmp"
            asset_failures=$((asset_failures + 1))
            warn "не удалось скачать fake-файл $fake_name"
        fi
    done < "$KZM_TMP/fake.references"
    [ "$asset_failures" -eq 0 ] || return 1
    return 0
}

profile_file_general() {
    case "$GENERAL_PROFILE" in
        flow:*)
            profile_name=${GENERAL_PROFILE#flow:}
            case "$profile_name" in *[!A-Za-z0-9_.-]*|'') die "некорректное имя Flowseal-стратегии" ;; esac
            printf '%s/%s.strategy\n' "$FLOWSEAL_DIR" "$profile_name"
            return
            ;;
        custom:*)
            profile_name=${GENERAL_PROFILE#custom:}
            ;;
        *)
            profile_name=$GENERAL_PROFILE
            printf '%s/%s.strategy\n' "$GENERAL_DIR" "$profile_name"
            return
            ;;
    esac
    case "$profile_name" in
        *[!A-Za-z0-9_.-]*|'') die "некорректное имя custom-стратегии" ;;
    esac
    printf '%s/%s.strategy\n' "$CUSTOM_DIR" "$profile_name"
}

general_profile_label() {
    case "$GENERAL_PROFILE" in
        flow:*)
            profile_id=${GENERAL_PROFILE#flow:}
            profile_label=$(awk -F'|' -v id="$profile_id" '$1 == id { print $2; exit }' "$FLOWSEAL_DIR/index.tsv" 2>/dev/null)
            if [ -n "$profile_label" ]; then
                printf 'Flowseal: %s' "$profile_label"
            else
                printf '%s' "$GENERAL_PROFILE"
            fi
            ;;
        *) printf '%s' "$GENERAL_PROFILE" ;;
    esac
}

profile_file_youtube() {
    printf '%s/%s.strategy\n' "$YOUTUBE_DIR" "$YOUTUBE_PROFILE"
}

canonicalize_strategy() {
    awk '
        /^[[:space:]]*$/ || /^#/ { next }
        $0 == "--new" { if (has_content) pending_new=1; next }
        {
            if (pending_new) { print "--new"; pending_new=0 }
            print
            has_content=1
        }
    ' "$1"
}

strategy_with_filter() {
    filter_source=$1
    filter_mode=$2
    filter_has_domains=0
    [ -s "$USER_LIST" ] && filter_has_domains=1
    awk \
        -v scope="$TRAFFIC_SCOPE" \
        -v mode="$filter_mode" \
        -v has_domains="$filter_has_domains" \
        -v user_list="$USER_LIST" \
        -v user_ipset="$USER_IPSET" \
        -v auto_list="$AUTO_LIST" \
        -v exclude_list="$EXCLUDE_LIST" '
        function emit_scope() {
            if (mode == "domain") {
                if (has_domains) {
                    print "--hostlist=" user_list
                }
                if (scope == "auto") {
                    print "--hostlist-auto=" auto_list
                }
            } else if (mode == "network") {
                print "--ipset=" user_ipset
                # Keep an include filter even if the file is emptied while
                # nfqws is running; otherwise an empty include can mean all.
                print "--ipset-ip=0.0.0.0"
            }
            print "--hostlist-exclude=" exclude_list
        }
        /^--hostlist-exclude=/ && !done {
            emit_scope()
            done=1
            next
        }
        { print }
        END {
            if (!done) {
                # Imported v-strategies currently always carry an exclude list.
                # Refuse silent scope changes if their format changes upstream.
                exit 3
            }
        }
    ' "$filter_source"
}

strategy_with_scope() {
    scope_source=$1
    case "$TRAFFIC_SCOPE" in
        all)
            strategy_with_filter "$scope_source" all
            ;;
        list|auto)
            scope_emitted=0
            if [ -s "$USER_LIST" ] || [ "$TRAFFIC_SCOPE" = auto ]; then
                strategy_with_filter "$scope_source" domain || return 1
                scope_emitted=1
            fi
            if [ -s "$USER_IPSET" ]; then
                if [ "$scope_emitted" -eq 1 ]; then
                    printf '%s\n' '--new'
                fi
                strategy_with_filter "$scope_source" network || return 1
                scope_emitted=1
            fi
            [ "$scope_emitted" -eq 1 ] || return 3
            ;;
        *) return 2 ;;
    esac
}

append_strategy() {
    append_source=$1
    append_target=$2
    append_tmp=$3
    canonicalize_strategy "$append_source" > "$append_tmp" || return 1
    [ -s "$append_tmp" ] || return 1
    if [ -s "$append_target" ]; then
        printf '%s\n' '--new' >> "$append_target"
    fi
    cat "$append_tmp" >> "$append_target"
}

render_quic_strategy() {
    quic_target=$1
    {
        printf '%s\n' '--filter-udp=443'
        printf '%s\n' "--hostlist=$YOUTUBE_LIST"
        printf '%s\n' '--dpi-desync=fake'
        # MT7981 loses UDP around NFQUEUE when GRO is active. One fake reduced
        # fallback latency on the tested path; QUIC success still depends on
        # the provider and the client may fall back to TCP.
        printf '%s\n' '--dpi-desync-repeats=1'
        printf '%s\n' "--dpi-desync-fake-quic=$FAKE_DIR/quic_initial_www_google_com.bin"
    } > "$quic_target"
}

render_discord_voice_strategy() {
    discord_voice_source=$1
    discord_voice_target=$2
    discord_fake_path=
    if [ "$DISCORD_FAKE" != off ]; then
        discord_fake_path="$FAKE_DIR/$DISCORD_FAKE"
        [ -s "$discord_fake_path" ] || die "нет fake-файла $DISCORD_FAKE; выполните: kzm update или выберите fake заново"
    fi
    awk -v fake_path="$discord_fake_path" '
        /^--dpi-desync-fake-(discord|stun)=/ { next }
        { print }
        END {
            if (fake_path != "") {
                print "--dpi-desync-fake-discord=" fake_path
                print "--dpi-desync-fake-stun=" fake_path
            }
        }
    ' "$discord_voice_source" > "$discord_voice_target"
}

render_composition() {
    render_target=$1
    ensure_layout
    validate_state
    : > "$render_target"

    if [ "$YOUTUBE_PROFILE" != "off" ]; then
        youtube_profile_file=$(profile_file_youtube)
        [ -f "$youtube_profile_file" ] || die "нет YouTube-стратегии $YOUTUBE_PROFILE; выполните: kzm update"
        validate_strategy "$youtube_profile_file" || die "повреждена стратегия $YOUTUBE_PROFILE"
        append_strategy "$youtube_profile_file" "$render_target" "$KZM_TMP/youtube.normalized" || die "пустая YouTube-стратегия"
    fi

    if [ "$QUIC_ENABLED" -eq 1 ]; then
        render_quic_strategy "$KZM_TMP/quic.strategy"
        append_strategy "$KZM_TMP/quic.strategy" "$render_target" "$KZM_TMP/quic.normalized" || die "пустой QUIC-блок"
    fi

    general_profile_file=$(profile_file_general)
    [ -f "$general_profile_file" ] || die "нет стратегии $GENERAL_PROFILE; выполните: kzm update"
    validate_strategy "$general_profile_file" || die "повреждена стратегия $GENERAL_PROFILE"
    strategy_with_scope "$general_profile_file" > "$KZM_TMP/general.scoped" || die "формат стратегии $GENERAL_PROFILE изменился и не поддерживает scope"
    append_strategy "$KZM_TMP/general.scoped" "$render_target" "$KZM_TMP/general.normalized" || die "пустая основная стратегия"

    if [ "$DISCORD_ENABLED" -eq 1 ]; then
        [ -f "$EXTRAS_DIR/discord-voice.strategy" ] || die "нет Discord voice-блока; выполните: kzm update"
        render_discord_voice_strategy "$EXTRAS_DIR/discord-voice.strategy" "$KZM_TMP/discord-voice.strategy"
        validate_strategy "$KZM_TMP/discord-voice.strategy" || die "повреждён Discord voice-блок"
        append_strategy "$KZM_TMP/discord-voice.strategy" "$render_target" "$KZM_TMP/discord-voice.normalized" || die "пустой Discord voice-блок"
        if [ "$DISCORD_MEDIA_PROFILE" != "off" ]; then
            discord_media_file="$DISCORD_DIR/$DISCORD_MEDIA_PROFILE.strategy"
            [ -f "$discord_media_file" ] || die "нет Discord media-профиля $DISCORD_MEDIA_PROFILE; выполните: kzm update"
            validate_strategy "$discord_media_file" || die "повреждён профиль $DISCORD_MEDIA_PROFILE"
            append_strategy "$discord_media_file" "$render_target" "$KZM_TMP/discord-media.normalized" || die "пустой Discord media-профиль"
        fi
    fi

    case "$DISCORD_SCRIPT" in
        off) ;;
        50-discord-media)
            # Safe Keenetic mapping: this name is an alias for the existing
            # KZM Discord voice/media composition above, never a second block.
            ;;
        *) die "режим $DISCORD_SCRIPT недоступен в безопасном режиме Keenetic; выберите off или 50-discord-media" ;;
    esac

    if [ "$GAME_ENABLED" -eq 1 ]; then
        [ -f "$EXTRAS_DIR/game.strategy" ] || die "нет игрового блока; выполните: kzm update"
        append_strategy "$EXTRAS_DIR/game.strategy" "$render_target" "$KZM_TMP/game.normalized" || die "пустой игровой блок"
    fi

    validate_strategy "$render_target" || die "собранная стратегия не прошла проверку"
}

render_candidate() {
    candidate_target=$1
    [ -f "$NFQWS_CONFIG" ] || die "не найден $NFQWS_CONFIG; требуется классический nfqws-keenetic"
    render_composition "$KZM_TMP/composed.strategy"
    awk -f "$KZM_LIBEXEC/render-replacements.awk" "$KZM_TMP/composed.strategy" > "$KZM_TMP/replacements.tsv" || die "не удалось собрать параметры nfqws"
    awk -v replacements_file="$KZM_TMP/replacements.tsv" -f "$KZM_LIBEXEC/patch-config.awk" "$NFQWS_CONFIG" > "$candidate_target" || die "не удалось сформировать конфиг"
    sh -n "$candidate_target" || die "сформированный nfqws.conf синтаксически некорректен"
    validate_candidate_with_engine "$candidate_target" || die "классический nfqws отклонил собранные параметры"
}

validate_candidate_with_engine() (
    candidate_config=$1
    [ -x "$NFQWS_BIN" ] || {
        warn "не найден классический бинарник $NFQWS_BIN"
        return 1
    }
    # shellcheck disable=SC1090
    . "$candidate_config"
    if [ -n "${NFQWS_ARGS_CUSTOM:-}" ]; then
        # Word splitting is intentional: nfqws expects one argv item per option.
        # Downloaded lines have already passed validate_strategy.
        # shellcheck disable=SC2086
        "$NFQWS_BIN" --dry-run --qnum="${NFQUEUE_NUM:-200}" $NFQWS_ARGS_CUSTOM --new $NFQWS_ARGS
    else
        # shellcheck disable=SC2086
        "$NFQWS_BIN" --dry-run --qnum="${NFQUEUE_NUM:-200}" $NFQWS_ARGS
    fi
)

timestamp() {
    date '+%Y%m%d-%H%M%S'
}

prune_backups() {
    [ "$BACKUP_KEEP" -ge 1 ] 2>/dev/null || BACKUP_KEEP=10
    # Names are generated by this program and cannot contain whitespace.
    # shellcheck disable=SC2012
    ls -1t "$BACKUP_DIR"/nfqws.conf.* 2>/dev/null | awk -v keep="$BACKUP_KEEP" 'NR > keep' | while IFS= read -r old_backup; do
        case "$old_backup" in
            "$BACKUP_DIR"/nfqws.conf.*) rm -f "$old_backup" ;;
        esac
    done
}

create_backup() {
    ensure_layout
    [ -f "$NFQWS_CONFIG" ] || die "нечего резервировать: $NFQWS_CONFIG отсутствует"
    backup_path="$BACKUP_DIR/nfqws.conf.$(timestamp).$$"
    cp -p "$NFQWS_CONFIG" "$backup_path" || die "не удалось создать резервную копию"
    prune_backups
    printf '%s\n' "$backup_path"
}

restart_service() {
    [ -x "$NFQWS_INIT" ] || {
        warn "не найден исполняемый $NFQWS_INIT"
        return 1
    }
    if [ -x "$KZM_LIBEXEC/mediatek-gro-fix.sh" ]; then
        "$KZM_LIBEXEC/mediatek-gro-fix.sh" apply ||
            warn "не удалось применить MT7981 GRO-fix; QUIC может терять пакеты"
    fi
    "$NFQWS_INIT" restart
}

apply_config() {
    do_restart=0
    confirmed=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --restart) do_restart=1 ;;
            --yes) confirmed=1 ;;
            *) die "неизвестный параметр apply: $1" ;;
        esac
        shift
    done
    if [ "$do_restart" -eq 1 ] && [ "$confirmed" -ne 1 ]; then
        die "для перезапуска явно добавьте --yes"
    fi
    if [ "$do_restart" -eq 1 ] && [ ! -x "$NFQWS_INIT" ]; then
        die "не найден $NFQWS_INIT; конфиг не изменён"
    fi
    make_tmp
    render_candidate "$KZM_TMP/nfqws.conf"
    backup_path=$(create_backup) || die "не удалось создать резервную копию; конфиг не изменён"
    had_active_strategy=0
    had_configured_state=0
    if [ -f "$ACTIVE_STRATEGY" ]; then
        cp "$ACTIVE_STRATEGY" "$KZM_TMP/previous-active.strategy" || die "не удалось сохранить метаданные текущего конфига"
        had_active_strategy=1
    fi
    if [ -f "$CONFIGURED_STATE" ]; then
        cp "$CONFIGURED_STATE" "$KZM_TMP/previous-configured-state.conf" || die "не удалось сохранить состояние текущего конфига"
        had_configured_state=1
    fi
    config_next="$NFQWS_CONFIG.kzm-new"
    cp "$KZM_TMP/nfqws.conf" "$config_next" || die "не удалось подготовить новый конфиг"
    chmod 600 "$config_next" 2>/dev/null || true
    mv "$config_next" "$NFQWS_CONFIG" || die "не удалось заменить nfqws.conf"
    if ! cp "$KZM_TMP/composed.strategy" "$ACTIVE_STRATEGY.next.$$" || \
       ! mv "$ACTIVE_STRATEGY.next.$$" "$ACTIVE_STRATEGY" || \
       ! cp "$STATE_FILE" "$CONFIGURED_STATE.next.$$" || \
       ! mv "$CONFIGURED_STATE.next.$$" "$CONFIGURED_STATE"; then
        rm -f "$ACTIVE_STRATEGY.next.$$" "$CONFIGURED_STATE.next.$$"
        cp "$backup_path" "$NFQWS_CONFIG"
        if [ "$had_active_strategy" -eq 1 ]; then
            cp "$KZM_TMP/previous-active.strategy" "$ACTIVE_STRATEGY"
        else
            rm -f "$ACTIVE_STRATEGY"
        fi
        if [ "$had_configured_state" -eq 1 ]; then
            cp "$KZM_TMP/previous-configured-state.conf" "$CONFIGURED_STATE"
        else
            rm -f "$CONFIGURED_STATE"
        fi
        die "не удалось сохранить состояние нового конфига; предыдущий конфиг возвращён"
    fi
    say "Конфиг записан. Резервная копия: $backup_path"
    if [ "$do_restart" -eq 1 ]; then
        if restart_service; then
            cp "$CONFIGURED_STATE" "$RUNNING_STATE.next.$$" && mv "$RUNNING_STATE.next.$$" "$RUNNING_STATE"
            say "Классический nfqws перезапущен."
        else
            warn "перезапуск не удался; возвращаю предыдущий конфиг"
            cp "$backup_path" "$NFQWS_CONFIG"
            if [ "$had_active_strategy" -eq 1 ]; then
                cp "$KZM_TMP/previous-active.strategy" "$ACTIVE_STRATEGY"
            else
                rm -f "$ACTIVE_STRATEGY"
            fi
            if [ "$had_configured_state" -eq 1 ]; then
                cp "$KZM_TMP/previous-configured-state.conf" "$CONFIGURED_STATE"
            else
                rm -f "$CONFIGURED_STATE"
            fi
            "$NFQWS_INIT" restart >/dev/null 2>&1 || true
            die "новая конфигурация отменена"
        fi
    else
        say "Служба НЕ перезапускалась. Для применения: kzm service restart --yes"
    fi
}

select_general() {
    selected=$1
    case "$selected" in
        v[0-9]*) selected_path="$GENERAL_DIR/$selected.strategy" ;;
        flow:*)
            flow_name=${selected#flow:}
            case "$flow_name" in *[!A-Za-z0-9_.-]*|'') die "некорректное имя Flowseal-профиля" ;; esac
            selected_path="$FLOWSEAL_DIR/$flow_name.strategy"
            ;;
        custom:*)
            custom_name=${selected#custom:}
            case "$custom_name" in *[!A-Za-z0-9_.-]*|'') die "некорректное имя" ;; esac
            selected_path="$CUSTOM_DIR/$custom_name.strategy"
            ;;
        *) die "ожидается vN, flow:NAME или custom:NAME" ;;
    esac
    [ -f "$selected_path" ] || die "стратегия $selected не найдена"
    GENERAL_PROFILE=$selected
    write_state_file
    say "Выбрана основная стратегия $selected. Конфиг ещё не менялся."
}

select_youtube() {
    selected=$1
    if [ "$selected" != "off" ]; then
        case "$selected" in Yv[0-9]*) ;; *) die "ожидается YvNN или off" ;; esac
        [ -f "$YOUTUBE_DIR/$selected.strategy" ] || die "стратегия $selected не найдена"
    fi
    YOUTUBE_PROFILE=$selected
    write_state_file
    say "YouTube-стратегия: $selected. Конфиг ещё не менялся."
}

select_toggle() {
    toggle_name=$1
    toggle_value=$2
    case "$toggle_value" in on|1) toggle_number=1 ;; off|0) toggle_number=0 ;; *) die "ожидается on или off" ;; esac
    case "$toggle_name" in
        discord) DISCORD_ENABLED=$toggle_number ;;
        quic) QUIC_ENABLED=$toggle_number ;;
        game) GAME_ENABLED=$toggle_number ;;
        *) die "неизвестный переключатель $toggle_name" ;;
    esac
    write_state_file
    say "$toggle_name: $toggle_value. Конфиг ещё не менялся."
