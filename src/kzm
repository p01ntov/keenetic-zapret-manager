normalize_domain() {
    printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' | sed -e 's#^[a-z][a-z0-9+.-]*://##' -e 's#/.*$##' -e 's/:.*$//' -e 's/^+\.//' -e 's/^\*\.//' -e 's/^\.//'
}

domain_valid() {
    printf '%s\n' "$1" | awk '
        length($0) < 1 || length($0) > 253 || $0 !~ /\./ { bad=1; next }
        {
            count=split($0, labels, ".")
            for (i=1; i<=count; i++) {
                if (length(labels[i]) < 1 || length(labels[i]) > 63 ||
                    labels[i] !~ /^[a-z0-9][a-z0-9-]*[a-z0-9]$/ &&
                    labels[i] !~ /^[a-z0-9]$/) {
                    bad=1
                }
            }
        }
        END { exit bad ? 1 : 0 }
    '
}

