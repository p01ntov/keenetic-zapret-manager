        say "Для перехода сначала нужен отдельный безопасный сценарий из MIGRATION.md."
        return 1
    fi
    if [ ! -x "$NFQWS_INIT" ] || [ ! -x "$NFQWS_BIN" ] || [ ! -f "$NFQWS_CONFIG" ]; then
        say "Классический nfqws-keenetic установлен не полностью. Ничего не изменено."
        return 1
    fi
    say "Будут записаны выбранные настройки, создана резервная копия и перезапущен только nfqws."
    say "SSH может кратко прерваться; при ошибке запуска конфиг будет автоматически возвращён."
    if ! menu_confirm "Применить настройки сейчас?"; then
        say "Применение отменено."
        return 0
    fi
    apply_config --restart --yes
}

