canary_engine_update() {
    case "$(uname -m 2>/dev/null)" in
        aarch64) ;;
        *) die "автоматическая установка canary-движка пока поддерживает только aarch64" ;;
    esac
    ensure_layout
    make_tmp
    say "Скачиваю индекс официального nfqws-keenetic..."
    fetch_url "$CANARY_FEED_URL/Packages.gz" "$KZM_TMP/Packages.gz" || die "не удалось скачать Packages.gz"
    if command -v gzip >/dev/null 2>&1; then
        gzip -dc "$KZM_TMP/Packages.gz" > "$KZM_TMP/Packages" || die "не удалось распаковать Packages.gz"
    elif [ -x /bin/busybox ]; then
        /bin/busybox gzip -dc "$KZM_TMP/Packages.gz" > "$KZM_TMP/Packages" || die "не удалось распаковать Packages.gz"
    else
        die "не найден gzip"
    fi
    package_filename=$(awk '
        $0 == "Package: nfqws-keenetic" { found=1; next }
        found && /^Filename: / { print $2; exit }
        found && /^$/ { exit }
    ' "$KZM_TMP/Packages")
    package_sha256=$(awk '
        $0 == "Package: nfqws-keenetic" { found=1; next }
        found && /^SHA256sum: / { print $2; exit }
        found && /^$/ { exit }
    ' "$KZM_TMP/Packages")
    package_version=$(awk '
        $0 == "Package: nfqws-keenetic" { found=1; next }
        found && /^Version: / { print $2; exit }
        found && /^$/ { exit }
    ' "$KZM_TMP/Packages")
    case "$package_filename" in
        nfqws-keenetic_*.ipk) ;;
        *) die "в индексе нет безопасного имени пакета nfqws-keenetic" ;;
    esac
    case "$package_filename" in *[!A-Za-z0-9_.-]*) die "имя пакета содержит запрещённые символы" ;; esac
    case "$package_sha256" in
        [0-9a-fA-F][0-9a-fA-F]*) ;;
        *) die "в индексе нет SHA256 пакета" ;;
    esac
    [ "${#package_sha256}" -eq 64 ] || die "длина SHA256 пакета некорректна"
    fetch_url "$CANARY_FEED_URL/$package_filename" "$KZM_TMP/$package_filename" || die "не удалось скачать $package_filename"
    actual_sha256=$(sha256sum "$KZM_TMP/$package_filename" | awk '{ print $1 }')
    [ "$actual_sha256" = "$package_sha256" ] || die "SHA256 пакета nfqws не совпал"

    mkdir -p "$KZM_TMP/package" || die "не удалось создать каталог распаковки"
    (
        cd "$KZM_TMP/package" || exit 1
        tar -xzf "$KZM_TMP/$package_filename" || exit 1
        [ -f data.tar.gz ] || exit 1
        tar -xzf data.tar.gz || exit 1
        [ -x opt/usr/bin/nfqws ] || exit 1
    ) || die "не удалось безопасно извлечь nfqws из ipk"
    "$KZM_TMP/package/opt/usr/bin/nfqws" --version >/dev/null 2>&1 || die "извлечённый nfqws не запускается"
    cp "$KZM_TMP/package/opt/usr/bin/nfqws" "$KZM_CANARY_BIN.next" || die "не удалось подготовить canary-движок"
    chmod 755 "$KZM_CANARY_BIN.next" || die "не удалось выставить права canary-движка"
    mv "$KZM_CANARY_BIN.next" "$KZM_CANARY_BIN" || die "не удалось установить canary-движок"
    printf 'package=%s\nversion=%s\nsha256=%s\n' "$package_filename" "$package_version" "$package_sha256" > "$TOOLS_DIR/nfqws.source"
    say "Canary nfqws $package_version извлечён в $KZM_CANARY_BIN. Пакет не устанавливался, службы не запускались."
}

canary_live_require() {
    ensure_layout
    [ -x "$KZM_CANARY_BIN" ] || die "нет изолированного nfqws; выполните: kzm test engine-update"
    [ -x "$KZM_LIBEXEC/router-canary.sh" ] || die "не найден router-canary.sh; переустановите менеджер"
    command -v iptables >/dev/null 2>&1 || die "для live-теста нужен iptables"
    [ -r "$KZM_PROC_ROOT/net/netfilter/nfnetlink_queue" ] || die "ядро не предоставляет NFQUEUE"
    iptables -t mangle -nL POSTROUTING >/dev/null 2>&1 || die "не найдена mangle-цепочка POSTROUTING для временного теста"
}

canary_require() {
    canary_live_require
    [ -x "$KZM_LIBEXEC/router-canary-matrix.sh" ] || die "не найден router-canary-matrix.sh; переустановите менеджер"
    command -v curl >/dev/null 2>&1 || die "для HTTP-тестов нужен curl: opkg install curl"
}

ipv4_valid() {
    printf '%s\n' "$1" | awk -F. '
        NF != 4 { exit 1 }
        { for (i=1; i<=4; i++) if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit 1 }
    '
}

canary_ttl_valid() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -ge 15 ] 2>/dev/null && [ "$1" -le 300 ] 2>/dev/null
}

youtube_profile_valid() {
    youtube_profile_suffix=${1#Yv}
    [ "$youtube_profile_suffix" != "$1" ] || return 1
    case "$youtube_profile_suffix" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

resolve_ipv4() {
    resolve_host=$1
    nslookup "$resolve_host" 2>/dev/null | awk '
        /^Name:/ { answer=1; next }
        answer && /^Address/ {
            ip=$NF
            if (ip ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) { print ip; exit }
        }
    '
}

route_source_ipv4() {
    ip route get "$1" 2>/dev/null | awk '
        { for (i=1; i<=NF; i++) if ($i == "src") { print $(i+1); exit } }
    '
}

