doctor_command() {
    failures=0
    say "Проверка окружения (без изменений и перезапусков):"
    for required in awk sed grep find sort mktemp cmp unzip; do
        if command -v "$required" >/dev/null 2>&1; then
            say "  OK  $required"
        else
            say "  FAIL $required"
            failures=$((failures + 1))
        fi
    done
    if [ -x "$NFQWS_BIN" ] && [ -x "$NFQWS_INIT" ] && [ -f "$NFQWS_CONFIG" ]; then
        say "  OK  классический nfqws-keenetic"
    else
        say "  FAIL классический nfqws-keenetic не установлен полностью"
        failures=$((failures + 1))
    fi
    if [ -e "$NFQWS2_INIT" ]; then
        say "  WARN установлен конфликтующий nfqws2-keenetic"
    fi
    general_count=$(count_profiles "$GENERAL_DIR")
    flowseal_count=$(count_profiles "$FLOWSEAL_DIR")
    youtube_count=$(count_profiles "$YOUTUBE_DIR")
    discord_count=$(count_profiles "$DISCORD_DIR")
    test_target_count=$(awk 'END { print NR+0 }' "$TEST_TARGETS" 2>/dev/null)
    say "  INFO стратегии: v=$general_count Flowseal=$flowseal_count youtube=$youtube_count discord=$discord_count"
    say "  INFO целей полного теста: ${test_target_count:-0}"
    if [ -f "$YOUTUBE_LIST" ]; then
        missing_youtube_domains=""
        for required_youtube_domain in youtube.com googlevideo.com youtubei.googleapis.com youtubei-att.googleapis.com; do
            if ! grep -qxF "$required_youtube_domain" "$YOUTUBE_LIST" 2>/dev/null; then
                missing_youtube_domains="$missing_youtube_domains $required_youtube_domain"
            fi
        done
        if [ -n "$missing_youtube_domains" ]; then
            say "  FAIL в списке YouTube отсутствуют:$missing_youtube_domains"
            failures=$((failures + 1))
        else
            say "  OK  основные домены браузера и приложения YouTube"
        fi
    else
        say "  FAIL не найден список YouTube: $YOUTUBE_LIST"
        failures=$((failures + 1))
    fi
    if command -v ip >/dev/null 2>&1 && ip -6 route show default 2>/dev/null | grep -q .; then
        ipv6_setting=$(awk -F= '$1 == "IPV6_ENABLED" { print substr($0, index($0, "=") + 1); exit }' "$NFQWS_CONFIG" 2>/dev/null | tr -d '[:space:]"')
        if [ "$ipv6_setting" = 1 ]; then
            say "  OK  IPv6-маршрут активен и IPV6_ENABLED=1"
        else
            say "  WARN IPv6-маршрут активен, но IPV6_ENABLED не равен 1"
        fi
        say "  INFO двухминутный canary устройства проверяет только IPv4"
    fi
    [ "$general_count" -gt 0 ] || failures=$((failures + 1))
    [ "$flowseal_count" -gt 0 ] || failures=$((failures + 1))
    [ "$discord_count" -gt 0 ] || failures=$((failures + 1))
    [ "${test_target_count:-0}" -ge 23 ] 2>/dev/null || failures=$((failures + 1))
    [ "$failures" -eq 0 ]
}

cleanup_command() {
    confirmed=${1:-}
    [ "$confirmed" = "--yes" ] || die "для очистки auto.list добавьте --yes"
    ensure_layout
    : > "$AUTO_LIST"
    rm -f "$KZM_BASE/var/log/kzapret-auto.log" "$KZM_BASE/var/log/kzapret-auto.log.1"
    say "Очищены auto.list и журналы автодобавления. Каталоги и выбранные стратегии сохранены."
}

file_size_bytes() {
    if [ -f "$1" ]; then
        wc -c < "$1" 2>/dev/null | tr -d '[:space:]'
    else
        printf '0'
    fi
}

storage_status_command() {
    mihomo_log_size=$(file_size_bytes "$MIHOMO_LOG")
    mihomo_old_size=$(file_size_bytes "$MIHOMO_LOG.1")
    auto_log_size=$(file_size_bytes "$KZM_BASE/var/log/kzapret-auto.log")
    auto_old_size=$(file_size_bytes "$KZM_BASE/var/log/kzapret-auto.log.1")
    total_size=$((mihomo_log_size + mihomo_old_size + auto_log_size + auto_old_size))
    say "Безопасно очищаемые журналы: $total_size байт"
    say "  Mihomo: $mihomo_log_size байт; архив: $mihomo_old_size байт"
    say "  KZM auto: $auto_log_size байт; архив: $auto_old_size байт"
    say "cache.db и файлы web-панели не учитываются: это рабочие данные, а не мусор."
    say "Кэш самой MetaCubeXD хранится в браузере, а не на флешке роутера."
}

storage_cleanup_command() {
    [ "${1:-}" = "--yes" ] || die "для очистки журналов добавьте --yes"
    case "$MIHOMO_LOG" in
        "$KZM_BASE"/var/log/*) ;;
        *) die "MIHOMO_LOG должен находиться внутри $KZM_BASE/var/log" ;;
    esac
    before_size=$((
        $(file_size_bytes "$MIHOMO_LOG") +
        $(file_size_bytes "$MIHOMO_LOG.1") +
        $(file_size_bytes "$KZM_BASE/var/log/kzapret-auto.log") +
        $(file_size_bytes "$KZM_BASE/var/log/kzapret-auto.log.1")
    ))
    if [ -f "$MIHOMO_LOG" ]; then
        : > "$MIHOMO_LOG" || die "не удалось очистить $MIHOMO_LOG"
    fi
    rm -f "$MIHOMO_LOG.1"
    if [ -f "$KZM_BASE/var/log/kzapret-auto.log" ]; then
        : > "$KZM_BASE/var/log/kzapret-auto.log" || die "не удалось очистить журнал KZM"
    fi
    rm -f "$KZM_BASE/var/log/kzapret-auto.log.1"
    say "Журналы очищены без остановки Mihomo и nfqws. Освобождено до $before_size байт."
    say "Конфиги, подписки, cache.db, rule-provider и web-панель сохранены."
}

service_command() {
    action=${1:-status}
    case "$action" in
        status)
            [ -x "$NFQWS_INIT" ] || die "не найден $NFQWS_INIT"
            "$NFQWS_INIT" status
            ;;
        restart)
            [ "${2:-}" = "--yes" ] || die "перезапуск может оборвать соединение; добавьте --yes"
            if restart_service; then
                if [ -f "$CONFIGURED_STATE" ]; then
                    cp "$CONFIGURED_STATE" "$RUNNING_STATE.next.$$" && mv "$RUNNING_STATE.next.$$" "$RUNNING_STATE"
                fi
                say "Классический nfqws перезапущен."
            else
                die "не удалось перезапустить классический nfqws"
            fi
            ;;
        *) die "service поддерживает status или restart --yes" ;;
    esac
}

