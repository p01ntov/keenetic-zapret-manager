build_backup_menu_index() {
    backup_index_target=$1
    : > "$backup_index_target"
    ensure_layout
    # Names are generated by this program and cannot contain whitespace.
    # shellcheck disable=SC2012
    ls -1t "$BACKUP_DIR"/nfqws.conf.* 2>/dev/null |
        sed 's#.*/##' | awk 'NF { print $0 "|" $0 }' > "$backup_index_target" || true
}

show_backups_interactive() {
    make_tmp
    build_backup_menu_index "$KZM_TMP/backups.tsv"
    if [ ! -s "$KZM_TMP/backups.tsv" ]; then
        say "Резервных копий пока нет."
        return 0
    fi
    say "Резервные копии (сначала новые):"
    menu_show_numbered "$KZM_TMP/backups.tsv"
}

restore_backup_interactive() {
    make_tmp
    build_backup_menu_index "$KZM_TMP/backups.tsv"
    if [ ! -s "$KZM_TMP/backups.tsv" ]; then
        say "Резервных копий пока нет."
        return 0
    fi
    if ! menu_choose_numbered "$KZM_TMP/backups.tsv" "Какую копию восстановить"; then
        say "Восстановление отменено."
        return 0
    fi
    restore_name=$MENU_SELECTED
    if menu_confirm "Восстановить $restore_name без перезапуска службы?"; then
        restore_command "$restore_name"
    else
        say "Восстановление отменено."
    fi
}

