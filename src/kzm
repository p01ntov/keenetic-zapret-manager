show_legacy_strategy_test_results() {
    result_file=${1:-$LAST_TEST_RESULT}
    [ -s "$result_file" ] || {
        say "Сохранённых результатов пока нет."
        return 1
    }
    grep -q '^strategy,attempt,curl_rc,http_code,tls_seconds,total_seconds,queue_packets$' "$result_file" || {
        warn "файл результатов повреждён"
        return 1
    }
    if [ -s "$LAST_TEST_META" ]; then
        say "Последняя проверка: $(cat "$LAST_TEST_META")"
    else
        say "Результаты последней проверки:"
    fi
    awk -F, -v current_profile="$GENERAL_PROFILE" '
        NR == 1 { next }
        NF >= 7 {
            name=$1
            if (!(name in seen)) { seen[name]=1; order[++count]=name }
            total[name]++
            if ($3 == "0" && $4 != "000") ok[name]++
            seconds[name]+=$6
            packets[name]+=$7
        }
        END {
            for (i=1; i<=count; i++) {
                name=order[i]
                label=name
                if (name == "control") label="без обхода"
                if (name == "current") label="текущая (" current_profile ")"
                if (ok[name] == total[name]) status="РАБОТАЕТ"
                else if (ok[name] > 0) status="НЕСТАБИЛЬНО"
                else status="НЕ РАБОТАЕТ"
                average=total[name] ? seconds[name]/total[name] : 0
                printf "  %-18s %-13s %d/%d, %.2f с, пакетов: %d\n", label, status, ok[name]+0, total[name], average, packets[name]+0
            }
        }
    ' "$result_file"
    control_counts=$(awk -F, '
        NR > 1 && $1 == "control" { total++; if ($3 == "0" && $4 != "000") ok++ }
        END { printf "%d:%d", ok+0, total+0 }
    ' "$result_file")
    control_ok=${control_counts%%:*}
    control_total=${control_counts#*:}
    if [ "$control_total" -gt 0 ] && [ "$control_ok" -eq "$control_total" ]; then
        say "Вывод: адрес доступен и без обхода. По этому тесту выбирать новую стратегию не нужно."
    elif [ "$control_ok" -eq 0 ] && [ "$control_total" -gt 0 ]; then
        say "Вывод: без обхода адрес недоступен; рабочие строки действительно показывают обход."
    else
        say "Вывод: контроль нестабилен, поэтому результат лучше повторить позже."
    fi
}

show_suite_strategy_test_results() {
    result_file=$1
    if [ -s "$LAST_TEST_META" ]; then
        say "Последняя проверка: $(cat "$LAST_TEST_META")"
    else
        say "Результаты последней проверки:"
    fi
    awk -F'|' '
        NR == 1 { next }
        NF >= 9 && $1 == "control" {
            control[$3]=$4+0
            control_ok+=$4
            control_total++
            if ($9+0 > control_packets) control_packets=$9+0
            next
        }
        NF >= 9 {
            id=$1
            if (!(id in seen)) {
                seen[id]=1
                order[++count]=id
                label[id]=$2
            }
            total[id]++
            ok[id]+=$4
            seconds[id]+=$8
            if ($9+0 > packets[id]) packets[id]=$9+0
            if (($4+0) == 1 && control[$3] == 0) rescued[id]++
            if (($4+0) == 0 && control[$3] == 1) regressions[id]++
        }
        END {
            printf "Контроль без обхода: %d/%d\n", control_ok+0, control_total+0
            if (control_packets == 0) {
                print "  ВНИМАНИЕ: контроль не прошёл через временную очередь; весь результат недостоверен."
            }
            print ""
            print "Стратегии по числу доступных целей, от меньшего к большему:"
            print "  плюс — открыла недоступное в контроле, минус — сломала доступное"
            for (i=1; i<count; i++) {
                for (j=i+1; j<=count; j++) {
                    left=order[i]
                    right=order[j]
                    if ((ok[left]+0) > (ok[right]+0)) {
                        swap=order[i]
                        order[i]=order[j]
                        order[j]=swap
                    }
                }
            }
            for (i=1; i<=count; i++) {
                id=order[i]
                if (packets[id] == 0) {
                    status="НЕДОСТОВЕРНО"
                } else if (regressions[id] == 0 && rescued[id] > 0) {
                    status="ПОДХОДИТ"
                } else if (rescued[id] > 0) {
                    status="С КОМПРОМИССОМ"
                } else {
                    status="БЕЗ УЛУЧШЕНИЯ"
                }
                printf "  %-34s %3d/%-3d  +%d/-%d  %s\n", label[id], ok[id]+0, total[id]+0, rescued[id]+0, regressions[id]+0, status
            }
        }
    ' "$result_file"
    say ""
    say "FAIL не всегда означает блокировку: адрес мог временно не отвечать. Для выбора важнее +/− относительно контроля."
}

show_strategy_test_results() {
    result_file=${1:-$LAST_TEST_RESULT}
    [ -s "$result_file" ] || {
        say "Сохранённых результатов пока нет."
        return 1
    }
    result_header=$(sed -n '1p' "$result_file")
    case "$result_header" in
        'strategy_id|strategy_label|target|ok|curl_rc|http_code|bytes|seconds|queue_packets')
            show_suite_strategy_test_results "$result_file"
            ;;
        'strategy,attempt,curl_rc,http_code,tls_seconds,total_seconds,queue_packets')
            show_legacy_strategy_test_results "$result_file"
            ;;
        *)
            warn "файл результатов повреждён или имеет неизвестный формат"
            return 1
            ;;
    esac
}

recommended_legacy_profile_from_results() {
    result_file=$1
    awk -F, -v current="$GENERAL_PROFILE" '
        NR == 1 || $1 == "control" || $1 == "current" { next }
        NF >= 7 {
            total[$1]++
            if ($3 == "0" && $4 != "000") ok[$1]++
            seconds[$1]+=$6
        }
        END {
            if (total[current] > 0 && ok[current] == total[current]) {
                print current
                exit
            }
            for (name in total) {
                if (ok[name] != total[name]) continue
                average=seconds[name]/total[name]
                if (best == "" || average < best_time) {
                    best=name
                    best_time=average
                }
            }
            if (best != "") print best
        }
    ' "$result_file"
}

recommended_profile_from_results() {
    result_file=$1
    result_header=$(sed -n '1p' "$result_file")
    if [ "$result_header" = 'strategy,attempt,curl_rc,http_code,tls_seconds,total_seconds,queue_packets' ]; then
        recommended_legacy_profile_from_results "$result_file"
        return
    fi
    [ "$result_header" = 'strategy_id|strategy_label|target|ok|curl_rc|http_code|bytes|seconds|queue_packets' ] || return
    awk -F'|' -v current="$GENERAL_PROFILE" '
        NR == 1 { next }
        $1 == "control" {
            control[$3]=$4+0
            if ($9+0 > control_packets) control_packets=$9+0
            next
        }
        NF >= 9 {
            id=$1
            if (!(id in seen)) { seen[id]=1; order[++count]=id }
            ok[id]+=$4
            seconds[id]+=$8
            if ($9+0 > packets[id]) packets[id]=$9+0
            if (($4+0) == 1 && control[$3] == 0) rescued[id]++
            if (($4+0) == 0 && control[$3] == 1) regressions[id]++
        }
        END {
            if (control_packets == 0) exit
            for (i=1; i<=count; i++) {
                id=order[i]
                if (packets[id] == 0 || regressions[id] != 0 || rescued[id] == 0) continue
                prefer_current=(id == current ? 1 : 0)
                if (best == "" || rescued[id] > best_rescued ||
                    (rescued[id] == best_rescued && ok[id] > best_ok) ||
                    (rescued[id] == best_rescued && ok[id] == best_ok && prefer_current > best_current) ||
                    (rescued[id] == best_rescued && ok[id] == best_ok && prefer_current == best_current && seconds[id] < best_seconds)) {
                    best=id
                    best_rescued=rescued[id]
                    best_ok=ok[id]
                    best_current=prefer_current
                    best_seconds=seconds[id]
                }
            }
            if (best != "") print best
        }
    ' "$result_file"
}

run_strategy_test_interactive() {
    test_mode=$1
    ensure_layout
    ensure_test_engine_interactive || return 1
    recommend_after_test=0
    case "$test_mode" in
        all)
            validate_test_targets "$TEST_TARGETS" || {
                say "Полный список тестов ещё не загружен. Выполните пункт обновления каталога."
                return 1
            }
            test_target_count=$(awk 'END { print NR+0 }' "$TEST_TARGETS")
            test_strategy_count=$(( $(count_profiles "$GENERAL_DIR") + $(count_profiles "$FLOWSEAL_DIR") ))
            say "Будут проверены $test_strategy_count стратегий на $test_target_count адресах. Это долгий тест."
            say "Основной Zapret не останавливается; проверка идёт через отдельную очередь $CANARY_QUEUE_NUM."
            menu_confirm "Начать полный автоподбор?" || {
                say "Тест отменён."
                return 0
            }
            test_title="полный автоподбор v + Flowseal ($test_target_count целей)"
            run_canary_suite_test all "$TEST_TARGETS" "$test_title" || return 1
            recommend_after_test=1
            ;;
        current)
            validate_test_targets "$TEST_TARGETS" || {
                say "Полный список тестов ещё не загружен. Выполните пункт обновления каталога."
                return 1
            }
            test_target_count=$(awk 'END { print NR+0 }' "$TEST_TARGETS")
            test_title="текущая стратегия $(general_profile_label), $test_target_count целей"
            run_canary_suite_test current "$TEST_TARGETS" "$test_title" || return 1
            ;;
        domain)
            printf 'Один или несколько доменов через пробел: '
            IFS= read -r test_domains_input || test_domains_input=
            [ -n "$test_domains_input" ] || {
                say "Домены не указаны."
                return 1
            }
            set -f
            # Word splitting is intentional; glob expansion is disabled above.
            # shellcheck disable=SC2086
            set -- $test_domains_input
            set +f
            canary_domain_suite_test "$@" || return 1
            recommend_after_test=1
            ;;
        *) die "неизвестный интерактивный режим теста" ;;
    esac
    say ""
    show_strategy_test_results "$LAST_TEST_RESULT"
    [ "$recommend_after_test" -eq 1 ] || return 0
    recommended_profile=$(recommended_profile_from_results "$LAST_TEST_RESULT")
    [ -n "$recommended_profile" ] || {
        say "Безопасной рекомендации нет: ни одна стратегия не улучшила контроль без регрессий. Выбор не изменён."
        return 0
    }
    if [ "$recommended_profile" = "$GENERAL_PROFILE" ]; then
        say "Текущая стратегия $(general_profile_label) остаётся лучшим безопасным вариантом."
        return 0
    fi
    say "Рекомендация: $recommended_profile. Это изменит только выбор в KZM, без записи конфига и перезапуска."
    if menu_confirm "Выбрать $recommended_profile?"; then
        select_general "$recommended_profile"
    else
        say "Текущий выбор $(general_profile_label) сохранён."
    fi
}

detect_ssh_client_ip() {
    printf '%s\n' "${SSH_CLIENT:-}" | awk '{ print $1 }'
}

router_has_ipv6_default_route() {
    # A test root must not inspect the host running the local test suite.
    [ -z "$KZM_ROOT" ] || return 1
    command -v ip >/dev/null 2>&1 || return 1
    ip -6 route show default 2>/dev/null | grep -q '^[[:space:]]*default[[:space:]]'
}

router_mihomo_running() {
    # Read /proc directly so the diagnostic cannot match its own grep/awk.
    [ -z "$KZM_ROOT" ] || return 1
    for mihomo_comm_file in /proc/[0-9]*/comm; do
        [ -r "$mihomo_comm_file" ] || continue
        mihomo_process_name=$(sed -n '1p' "$mihomo_comm_file" 2>/dev/null)
        [ "$mihomo_process_name" = mihomo ] && return 0
    done
    return 1
}

router_mihomo_transparent_running() {
    # Local tests may emulate the exact supported topology without inspecting
    # or changing the host firewall. This hook is ignored on a real router.
    if [ -n "$KZM_ROOT" ]; then
        [ "${KZM_TEST_MIHOMO_TRANSPARENT:-0}" = 1 ]
        return
    fi
    command -v iptables >/dev/null 2>&1 || return 1
    command -v iptables-save >/dev/null 2>&1 || return 1
    iptables -t nat -nL MIHOMO_REDIRECT >/dev/null 2>&1 || return 1
    iptables-save -t nat 2>/dev/null | awk '
        $1 == "-A" && $2 == "MIHOMO_REDIRECT" {
            for (i=3; i<NF; i++) {
                if ($i == "-j" && $(i+1) == "REDIRECT") found=1
            }
        }
        END { exit found ? 0 : 1 }
    '
}

prompt_client_ipv4() {
