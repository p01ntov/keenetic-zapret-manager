normalize_network() {
    printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

network_valid() {
    printf '%s\n' "$1" | awk '
        function ipv4_valid(address, count, octets, i) {
            count=split(address, octets, ".")
            if (count != 4) return 0
            for (i=1; i<=4; i++) {
                if (octets[i] !~ /^[0-9]+$/ || octets[i] + 0 > 255) return 0
            }
            return 1
        }
        function ipv6_valid(address, copy, doubles, count, groups, i, used) {
            if (address !~ /:/ || address ~ /[^0-9a-f:]/ || address ~ /:::/) return 0
            if (substr(address, 1, 1) == ":" && substr(address, 1, 2) != "::") return 0
            if (substr(address, length(address), 1) == ":" && substr(address, length(address)-1, 2) != "::") return 0
            copy=address
            doubles=gsub(/::/, "::", copy)
            if (doubles > 1) return 0
            count=split(address, groups, ":")
            used=0
            for (i=1; i<=count; i++) {
                if (groups[i] == "") continue
                if (groups[i] !~ /^[0-9a-f]+$/ || length(groups[i]) > 4) return 0
                used++
            }
            if (doubles == 1) return used < 8
            return used == 8
        }
        {
            value=$0
            if (value == "" || value ~ /[[:space:]]/ || value ~ /\/$/ || value ~ /\/.*\//) exit 1
            part_count=split(value, parts, "/")
            if (part_count < 1 || part_count > 2 || parts[1] == "") exit 1
            prefix=parts[2]
            if (ipv4_valid(parts[1])) {
                if (part_count == 2 && (prefix !~ /^[0-9]+$/ || prefix + 0 > 32)) exit 1
                exit 0
            }
            if (ipv6_valid(parts[1])) {
                if (part_count == 2 && (prefix !~ /^[0-9]+$/ || prefix + 0 > 128)) exit 1
                exit 0
            }
            exit 1
        }
    '
}

