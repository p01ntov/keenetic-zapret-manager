restore_command() {
    restore_name=${1:-}
    [ -n "$restore_name" ] || die "укажите имя резервной копии из kzm backup list"
    case "$restore_name" in */*|*\\*|.|..) die "укажите только имя файла" ;; esac
    restore_path="$BACKUP_DIR/$restore_name"
    [ -f "$restore_path" ] || die "резервная копия не найдена"
    sh -n "$restore_path" || die "резервная копия синтаксически повреждена"
    current_backup=$(create_backup) || die "не удалось зарезервировать текущий конфиг"
    cp "$restore_path" "$NFQWS_CONFIG.kzm-restore"
    chmod 600 "$NFQWS_CONFIG.kzm-restore" 2>/dev/null || true
    mv "$NFQWS_CONFIG.kzm-restore" "$NFQWS_CONFIG"
    rm -f "$ACTIVE_STRATEGY" "$CONFIGURED_STATE" "$RUNNING_STATE"
    say "Конфиг восстановлен без перезапуска. Предыдущее состояние: $current_backup"
}

build_general_menu_index() {
    general_index_target=$1
    : > "$general_index_target"
    find "$GENERAL_DIR" -type f -name 'v*.strategy' 2>/dev/null |
        sed 's#.*/v##; s/\.strategy$//' | sort -n |
        awk -v current="$GENERAL_PROFILE" -v recommended="$RECOMMENDED_GENERAL_PROFILE" '
            {
                id="v" $0
                label=id
                if (id == current) label=label " [сейчас]"
                if (id == recommended) label=label " [рекомендуется]"
                print id "|" label
            }
        ' >> "$general_index_target"
    if [ -s "$FLOWSEAL_DIR/index.tsv" ]; then
        awk -F'|' -v current="$GENERAL_PROFILE" -v recommended="$RECOMMENDED_GENERAL_PROFILE" '
            NF >= 2 {
                id="flow:" $1
                label="Flowseal: " $2
                if (id == current) label=label " [сейчас]"
                if (id == recommended) label=label " [рекомендуется]"
                print id "|" label
            }
        ' "$FLOWSEAL_DIR/index.tsv" >> "$general_index_target"
    fi
    find "$CUSTOM_DIR" -type f -name '*.strategy' 2>/dev/null |
        sed 's#.*/##; s/\.strategy$//' | sort |
        awk -v current="$GENERAL_PROFILE" '
            {
                id="custom:" $0
                label="Своя: " $0
                if (id == current) label=label " [сейчас]"
                print id "|" label
            }
        ' >> "$general_index_target"
}

