usage() {
    cat <<'EOF'
Использование: kzm COMMAND

  menu                              общее меню Keenetic Manager
  zapret                            меню стратегий, сайтов и тестов Zapret
  components COMMAND [...]          установка и управление TG-прокси
  status                            показать выбор и состояние движка
  doctor                            read-only проверка окружения
  update                            обновить v/Flowseal/YouTube/Discord, тесты и fake-файлы
  strategy list [general|youtube|discord|custom|all]
  strategy set general <vN|flow:NAME|custom:NAME>
  strategy set youtube <YvNN|off>
  strategy set discord <on|off>
  strategy set discord-media <DvN|off>
  strategy set discord-script <off|50-discord-media>
  strategy set discord-fake <NAME|off>
  strategy set quic <on|off>        QUIC UDP/443 для списка YouTube
  strategy set game <on|off>
  strategy set scope <all|list|auto>
  strategy import <NAME> <FILE>     импортировать custom-стратегию
  preview                           показать итог без записи
  apply [--restart --yes]           записать конфиг; по умолчанию без restart
  service status
  service restart --yes
  domain add <DOMAIN...>
  domain remove <DOMAIN...>
  domain list
  network add <IP_OR_CIDR...>       добавить IPv4/IPv6 адреса или подсети
  network remove <IP_OR_CIDR...>
  network list
  backup create|list
  backup restore <FILENAME>         восстановить без restart
  cleanup --yes                     очистить auto.list и его журналы
  storage status                    показать размер безопасно очищаемых журналов
  storage cleanup --yes             очистить журналы Mihomo/KZM без restart
  test engine-update                извлечь nfqws в отдельный каталог, без установки
  test suite [current|v|flowseal|all]
                                    полный список Zapret Manager через очередь 301
  test domain <DOMAIN...>           v + Flowseal на указанных доменах
  test general [HOST [PATH]]        короткий Discord/API-тест v-профилей
  test voice start <CLIENT_IP> [TTL]
  test quic start <CLIENT_IP> [TTL]
  test youtube start <CLIENT_IP> <YvNN> [TTL]
                                    TCP-профиль YouTube для одного IPv4; без apply/restart
  test status|stop                  счётчики или немедленный откат canary
  version

Без аргументов открывается общее меню. Старое меню Zapret доступно как `kzm zapret`.
EOF
}

main() {
    command=${1:-${KZM_DEFAULT_COMMAND:-menu}}
    [ "$#" -eq 0 ] || shift
    case "$command" in
        menu|manager) component_manager_command menu ;;
        zapret) interactive_menu ;;
        components|component) component_manager_command "$@" ;;
        status) status_command ;;
        doctor) doctor_command ;;
        update) catalog_update ;;
        preview) preview_command ;;
        apply) apply_config "$@" ;;
        service) service_command "$@" ;;
        cleanup) cleanup_command "$@" ;;
        storage)
            subcommand=${1:-status}
            [ "$#" -eq 0 ] || shift
            case "$subcommand" in
                status) storage_status_command ;;
                cleanup) storage_cleanup_command "$@" ;;
                *) die "storage поддерживает status или cleanup --yes" ;;
            esac
            ;;
        test) canary_test_command "$@" ;;
        version|--version|-V) say "$KZM_VERSION" ;;
        help|--help|-h) usage ;;
        strategy)
            subcommand=${1:-}
            [ "$#" -eq 0 ] || shift
            case "$subcommand" in
                list) list_strategies "${1:-all}" ;;
                set)
                    target=${1:-}
                    value=${2:-}
                    if [ -z "$target" ] || [ -z "$value" ]; then
                        die "strategy set требует цель и значение"
                    fi
                    case "$target" in
                        general) select_general "$value" ;;
                        youtube) select_youtube "$value" ;;
                        discord|quic|game) select_toggle "$target" "$value" ;;
                        discord-media) select_discord_media "$value" ;;
                        discord-script) select_discord_script "$value" ;;
                        discord-fake) select_discord_fake "$value" ;;
                        scope) select_scope "$value" ;;
                        *) die "цель: general, youtube, discord, discord-media, discord-script, discord-fake, quic, game или scope" ;;
                    esac
                    ;;
                import)
                    [ "$#" -eq 2 ] || die "strategy import требует NAME и FILE"
                    import_custom "$1" "$2"
                    ;;
                *) die "strategy поддерживает list, set и import" ;;
            esac
            ;;
        domain)
            subcommand=${1:-list}
            [ "$#" -eq 0 ] || shift
            case "$subcommand" in
                add) domain_add add "$@" ;;
                remove) domain_remove remove "$@" ;;
                list) ensure_layout; cat "$USER_LIST" ;;
                *) die "domain поддерживает add, remove и list" ;;
            esac
            ;;
        network|address|subnet)
            subcommand=${1:-list}
            [ "$#" -eq 0 ] || shift
            case "$subcommand" in
                add) network_add add "$@" ;;
                remove) network_remove remove "$@" ;;
                list) ensure_layout; cat "$USER_IPSET" ;;
                *) die "network поддерживает add, remove и list" ;;
            esac
            ;;
        backup)
            subcommand=${1:-list}
            [ "$#" -eq 0 ] || shift
            case "$subcommand" in
                create) create_backup ;;
                list)
                    ensure_layout
                    # Names are generated by this program and cannot contain whitespace.
                    # shellcheck disable=SC2012
                    ls -1t "$BACKUP_DIR"/nfqws.conf.* 2>/dev/null | sed 's#.*/##'
                    ;;
                restore) restore_command "$@" ;;
                *) die "backup поддерживает create, list и restore" ;;
            esac
            ;;
        *) usage; exit 1 ;;
    esac
}

main "$@"
